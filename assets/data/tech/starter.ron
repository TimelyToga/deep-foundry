// Tier 0-1 technologies. See docs/design/02-content.md section 8.
// The starter tech "bronze" needs scans of the ore veins the player finds in the world
// (malachite, cassiterite), not the dug powders (raw_malachite, raw_cassiterite).
[
    Tech(id: "bronze", name: "Bronze", description: "Mix copper and tin into bronze.", tier: 0, discoveries: ["malachite", "cassiterite"], unlocks: ["bronze_alloy", "bronze_gear"]),
    Tech(id: "research", name: "Research", description: "Labs and research kits.", tier: 0, requires: ["bronze"], unlocks: ["basic_lab", "bronze_kit"]),

    Tech(
        id: "bronze_drill_head",
        name: "Bronze drill head",
        description: "A harder drill head. Lets you dig into stone and go down into the upper stone layer.",
        tier: 1,
        requires: ["research"],
        kits: [("bronze_kit", 1)],
        units: 10,
        effects: [("dig_hardness", 1.0)],
    ),
    Tech(
        id: "steam_power",
        name: "Steam power",
        description: "Boilers make steam. Steam machines take it from pipes.",
        tier: 1,
        requires: ["research"],
        kits: [("bronze_kit", 1)],
        units: 10,
        unlocks: ["small_boiler", "bronze_pipe_section", "bronze_pipe"],
    ),
    Tech(
        id: "steam_machines_1",
        name: "Steam machines",
        description: "The steam crusher, wire drawer, extractor, press and lab.",
        tier: 1,
        requires: ["steam_power"],
        kits: [("bronze_kit", 1)],
        units: 15,
        unlocks: ["steam_crusher", "steam_wire_drawer", "steam_extractor", "steam_press", "steam_lab", "copper_wire"],
    ),
    Tech(
        id: "automation",
        name: "Automation",
        description: "Arms move items between buildings. The steam assembler makes gears, pipe sections and research kits on its own.",
        tier: 1,
        requires: ["steam_power"],
        kits: [("bronze_kit", 1)],
        units: 10,
        unlocks: ["arm", "steam_assembler"],
    ),
    Tech(
        id: "steam_smelting",
        name: "Steam smelting",
        description: "The steam furnace smelts ore and makes bronze with no fire.",
        tier: 1,
        requires: ["steam_machines_1"],
        kits: [("bronze_kit", 1)],
        units: 15,
        unlocks: ["steam_furnace"],
    ),
    Tech(
        id: "steam_mining",
        name: "Steam mining",
        description: "The steam drill mines the ground under it on its own.",
        tier: 1,
        requires: ["steam_machines_1", "bronze_drill_head"],
        kits: [("bronze_kit", 1)],
        units: 15,
        unlocks: ["steam_drill"],
    ),
    Tech(
        id: "iron_logistics",
        name: "Iron logistics",
        description: "Iron belts move twice as fast as wood belts and do not burn. Sorters and splitters route powder.",
        tier: 1,
        requires: ["steam_power"],
        kits: [("bronze_kit", 1)],
        units: 20,
        unlocks: ["iron_belt", "iron_crate", "sorter", "splitter"],
    ),
    Tech(
        id: "ore_processing",
        name: "Ore processing",
        description: "Crush iron ore and limestone.",
        tier: 1,
        requires: ["bronze_drill_head"],
        kits: [("bronze_kit", 1)],
        units: 20,
        discoveries: ["raw_hematite"],
        unlocks: ["crushed_magnetite", "crushed_hematite", "crushed_limestone"],
    ),
    Tech(
        id: "coke_and_iron",
        name: "Coke ovens and blast furnaces",
        description: "Coke ovens turn coal into coke. Blast furnaces turn iron ore into pig iron.",
        tier: 1,
        requires: ["ore_processing"],
        kits: [("bronze_kit", 2)],
        units: 30,
        unlocks: ["coke_oven_controller", "coke_oven_hatch", "coke", "firebrick_wall", "blast_furnace_controller", "blast_furnace_hatch", "steam_blower", "pig_iron_smelting", "pig_iron_from_hematite"],
    ),
    Tech(
        id: "steel_making",
        name: "Steel making",
        description: "The steel converter blows air through pig iron to make steel.",
        tier: 1,
        requires: ["coke_and_iron"],
        kits: [("bronze_kit", 1)],
        units: 20,
        unlocks: ["steel_converter", "steel_converting", "steel_plate", "crushed_slag"],
    ),
    Tech(
        id: "glass",
        name: "Glass",
        description: "Heat sand and ash to make glass. Cast it into panes and vials.",
        tier: 1,
        requires: ["steam_power"],
        kits: [("bronze_kit", 1)],
        units: 15,
        unlocks: ["pane_mold", "vial_mold", "molten_glass", "glass_pane", "glass_vial"],
    ),
    Tech(
        id: "rubber",
        name: "Rubber",
        description: "Extract resin from rubber tree wood and press it into rubber sheets.",
        tier: 1,
        requires: ["steam_machines_1"],
        kits: [("bronze_kit", 1)],
        units: 15,
        discoveries: ["rubber_wood"],
        unlocks: ["resin", "rubber", "rubber_sheet"],
    ),
    Tech(
        id: "steam_kit_tech",
        name: "Steam kit",
        description: "Combine a steel plate, a bronze pipe section and a glass vial into a steam research kit.",
        tier: 1,
        requires: ["glass", "steel_making"],
        kits: [("bronze_kit", 1)],
        units: 20,
        unlocks: ["steam_kit"],
    ),

    // --- Tier 2: LV ---
    Tech(
        id: "electricity",
        name: "Electricity",
        description: "Steam turbines make electric power; copper cables carry it to machines.",
        tier: 2,
        requires: ["steam_kit_tech"],
        kits: [("bronze_kit", 1), ("steam_kit", 1)],
        units: 20,
        unlocks: ["steam_turbine", "copper_cable", "electric_motor"],
    ),
    Tech(
        id: "lv_machines",
        name: "LV machines",
        description: "The macerator, the electric furnace, the electric assembler and the fast arm.",
        tier: 2,
        requires: ["electricity"],
        kits: [("bronze_kit", 1), ("steam_kit", 1)],
        units: 30,
        unlocks: ["macerator", "electric_furnace", "electric_assembler", "fast_arm"],
    ),
    Tech(
        id: "electric_mining",
        name: "Electric mining",
        description: "The electric drill digs deeper, faster and harder rock.",
        tier: 2,
        requires: ["lv_machines"],
        kits: [("bronze_kit", 1), ("steam_kit", 1)],
        units: 30,
        unlocks: ["electric_drill"],
    ),

    // The deep. See crates/worldgen/src/deep.rs: caves with glow moss under the start area,
    // granite from 1800 cells down (gold, geodes), basalt from 3600 (lava chambers).
    Tech(id: "cave_lights", name: "Cave lights", description: "Scan glow moss in a cave: make moss lanterns from it.", tier: 0, discoveries: ["glow_moss"], unlocks: ["moss_lantern"]),
    Tech(id: "crystal_lamps", name: "Crystal lamps", description: "Scan glow crystal in a geode: make bright crystal lamps from its shards.", tier: 1, requires: ["glass"], discoveries: ["glow_crystal"], unlocks: ["crystal_lamp"]),
    Tech(
        id: "steel_drill_head",
        name: "Steel drill head",
        description: "A steel drill head. The robot digs granite: the deep rock from 1800 cells down, with gold and crystal geodes.",
        tier: 1,
        requires: ["steel_making"],
        kits: [("bronze_kit", 1)],
        units: 30,
        effects: [("dig_hardness", 1.0)],
    ),
    Tech(
        id: "hard_drill_head",
        name: "Hard drill head",
        description: "A hardened steel drill head. The robot digs basalt and obsidian: the rock from 3600 cells down, with lava chambers.",
        tier: 2,
        requires: ["steel_drill_head", "electric_mining"],
        kits: [("bronze_kit", 1), ("steam_kit", 1)],
        units: 40,
        effects: [("dig_hardness", 1.0)],
    ),
    Tech(
        id: "gold",
        name: "Gold",
        description: "Scan native gold in the deep rock. Smelt it, draw gold wire and make circuits.",
        tier: 2,
        requires: ["electricity"],
        kits: [("bronze_kit", 1), ("steam_kit", 1)],
        units: 20,
        discoveries: ["native_gold"],
        unlocks: ["gold_smelting", "gold_plate", "gold_wire", "circuit"],
    ),
    Tech(
        id: "batteries",
        name: "Batteries",
        description: "Batteries store electric power for the times when the turbines make too little.",
        tier: 2,
        requires: ["gold", "lv_machines"],
        kits: [("bronze_kit", 1), ("steam_kit", 1)],
        units: 30,
        unlocks: ["battery"],
    ),
]
