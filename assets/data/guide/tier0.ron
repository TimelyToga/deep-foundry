// Guide goals for Tier 0: Hand and Fire. They follow "a typical first hour"
// (docs/design/01-game-design.md section 4) and chain A (docs/design/02-content.md section 7).
// Goals show in this order. Fields: see crates/factory/src/progress/guide.rs.
//
// Texts: say what to do, where, and with which key or button. Write keys as {key:ID} (all keys
// of the action, for example "A / Left") or {key1:ID} (the first key only), with the ids of
// crates/game/src/keys.rs. Never write a fixed letter: the player can change the keys, and on a
// Dvorak keyboard the letters are in other places. Mouse buttons are fixed.
//
// Resource directions describe the generated temperate starting area. Deposits and terrain
// vary with the seed; the scanner identifies the material under the pointer.
//
// `waits_for`: the machine or game part that the goal needs and that the game does not have yet
// (for example "the kiln"). The guide shows the goal gray, and when no other goal is open it says
// "Next: the kiln. It comes in a later update." Goals that the game can do come first. Remove
// `waits_for` when the game can do the goal; the test `tier0_goals_can_be_done`
// (crates/game/src/tier0_tests.rs) then needs a script for the goal.
[
    Goal(
        id: "t0_dig",
        tier: 0,
        title: "Dig sand",
        text: "Look for the pale sand patch just left of the Hub, or sand along a nearby shore. Move with {key:move_left} and {key:move_right}. Point at the sand and hold the left mouse button to dig. The sand goes into your material tanks (the panel right of the quickbar). Dig 100 units of sand.",
        condition: HaveItem("sand", 100),
        reward_points: 1,
    ),
    Goal(
        id: "t0_clay",
        tier: 0,
        title: "Find clay",
        text: "Clay is a gray-brown powder just below the ground near the Hub, especially to the right. You can also find it beneath the gravel beds of nearby streams and lakes. Hold the left mouse button on it to dig it. The robot keeps clay and throws plain dirt out behind itself. Dig 64 units of clay.",
        condition: HaveItem("clay", 64),
        reward_points: 1,
    ),
    Goal(
        id: "t0_wood",
        tier: 0,
        title: "Collect wood",
        text: "Find trees near the Hub and dig their wooden trunks. Walk with {key:move_left} and {key:move_right}; jump with {key1:jump} and hold it to fly over obstacles. You start with 30 wood. Have 60 units of wood.",
        condition: HaveItem("wood", 60),
        reward_points: 1,
    ),
    Goal(
        id: "t0_workbench",
        tier: 0,
        title: "Build a workbench",
        text: "Press {key:character} to open the character screen. In the Production tab, click Workbench (20 wood). The workbench goes to your quickbar: click it there, then left click on the ground near you to place it. Near a workbench, hand crafting is 2 times faster.",
        condition: Build("workbench", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t0_copper_ore",
        tier: 0,
        title: "Find copper ore",
        text: "Malachite is a green copper ore. Look just below the ground a short walk to either side of the Hub; more veins occur in the upper stone. Dig it with the left mouse button, or point at it and hold {key:scan} to scan it. Each new material that you dig or scan gives a discovery point.",
        condition: Discover("malachite"),
        reward_points: 1,
    ),
    Goal(
        id: "t0_tin_ore",
        tier: 0,
        title: "Find tin ore",
        text: "Cassiterite is a dark tin ore mixed into gravel beneath nearby streams and lakes. Explore along the surface until you find water, then inspect the gravel bed. Dig it with the left mouse button, or point at it and hold {key:scan}.",
        condition: Discover("cassiterite"),
        reward_points: 1,
    ),
    Goal(
        id: "t0_research_bronze",
        tier: 0,
        title: "Research Bronze",
        text: "Press {key:research} to open the research window. Click Research on Bronze. Bronze needs the discovery of copper ore and tin ore: find malachite and cassiterite first.",
        condition: Research("bronze"),
        reward_points: 1,
    ),
    Goal(
        id: "t0_raw_bricks",
        tier: 0,
        title: "Make raw clay bricks",
        text: "Press {key:character}. In the Intermediate tab, click Raw clay brick: a click makes 1, a right click makes 5. Each brick needs 16 clay, so 8 bricks need 128 clay. Make 8 raw clay bricks.",
        condition: HaveItem("raw_clay_brick", 8),
        reward_points: 1,
    ),
    Goal(
        id: "t0_campfire",
        tier: 0,
        title: "Build a campfire",
        text: "Press {key:character}. In the Power tab, click Campfire (10 wood). Click the campfire on your quickbar, then left click on the ground near you to place it.",
        condition: Build("campfire", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t0_fire_bricks",
        tier: 0,
        title: "Fire clay bricks",
        text: "Left click the campfire to open it. Shift + click your raw clay bricks to put them in. Click your wood tank on the bar at the bottom: the wood goes into the fuel slot. The fire bakes one clay brick in 30 seconds and burns 6 wood for it. Click the output slot to take the bricks. Have 8 clay bricks.",
        condition: HaveItem("clay_brick", 8),
        reward_points: 2,
    ),
    Goal(
        id: "t0_sluice",
        tier: 0,
        title: "Build a sluice",
        text: "Build a sluice and place it beside a water source. Its side inlet takes crushed ore, the top inlet takes water, and its three outlets separate washed ore from light silt and used water.",
        condition: Build("sluice", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t0_research_labs",
        tier: 0,
        title: "Research labs",
        text: "Press {key:research} and click Research on Research. It unlocks the basic lab and bronze research kits.",
        condition: Research("research"),
        reward_points: 1,
    ),

    Goal(
        id: "t0_kiln",
        tier: 0,
        title: "Build a kiln",
        text: "A kiln is a closed room of clay brick walls. It needs 24 clay bricks: fire more in the campfire. Press {key:character} and craft a kiln controller and a kiln hatch (Production tab) and 6 clay brick walls (Logistics tab). Place them as a ring of 3 by 3 tiles: the controller in a side wall, the hatch in the roof, the walls on the other 6 tiles. The middle tile stays empty: that is the room. Left click the controller: its window says if the room is closed, or where it has a hole.",
        condition: Build("kiln_controller", 1),
        reward_points: 2,
    ),
    Goal(
        id: "t0_charcoal",
        tier: 0,
        title: "Make charcoal",
        text: "Left click the kiln controller. Click the recipe slot and choose Charcoal. Click your wood tank on the bar at the bottom: the wood goes into the input and into the fuel slot. The fuel burns on the floor of the room and heats it. Charcoal needs 300 °C; a wood fire makes about 700 °C. Click the output slot to take the charcoal. Have 32 charcoal.",
        condition: HaveItem("charcoal", 32),
        reward_points: 1,
    ),

    // --- The goals below need machines that are not in the game yet. ---
    Goal(
        id: "t0_tin",
        tier: 0,
        title: "Smelt tin",
        text: "Set the crucible over a campfire. Choose Molten tin, add 16 cassiterite and 8 charcoal, then fuel the campfire with wood. The recipe waits for 900 °C. Cast molten tin in a plate mold to make tin plates.",
        condition: HaveItem("tin_plate", 4),
        reward_points: 2,
    ),
    Goal(
        id: "t0_bellows",
        tier: 0,
        title: "Build bellows",
        text: "Build bellows within 3 tiles of the campfire. They raise its real cell temperature by 300 °C, enough for copper smelting in the crucible.",
        condition: Build("bellows", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t0_copper",
        tier: 0,
        title: "Smelt copper",
        text: "Keep the crucible over the campfire. With bellows within 3 tiles, choose Molten copper and add 16 malachite and 8 charcoal. Fuel the fire; at 1100 °C the crucible makes molten copper. Cast it in a plate mold.",
        condition: HaveItem("copper_plate", 4),
        reward_points: 2,
    ),
    Goal(
        id: "t0_bronze",
        tier: 0,
        title: "Make bronze",
        text: "Load 48 molten copper and 16 molten tin into a crucible over 1000 °C. The alloy recipe uses the crucible's real temperature. Cast its molten bronze output in a plate mold.",
        condition: HaveItem("bronze_plate", 10),
        reward_points: 2,
    ),
    Goal(
        id: "t0_gears",
        tier: 0,
        title: "Make bronze gears",
        text: "Hand craft bronze gears from bronze plates. Machines need gears.",
        condition: HaveItem("bronze_gear", 4),
        reward_points: 1,
    ),
    Goal(
        id: "t0_stamp_mill",
        tier: 0,
        title: "Crush ore",
        text: "Build a stamp mill. Feed raw ore into its top port and take crushed ore from its side outlet. The mill works steadily without water power.",
        condition: HaveItem("crushed_malachite", 16),
        reward_points: 1,
    ),
    Goal(
        id: "t0_wash_ore",
        tier: 0,
        title: "Wash ore",
        text: "Carry crushed malachite to a sluice on a belt. Supply water at its top inlet; collect washed ore from the product outlet and let the water carry light silt out of the lower waste outlet.",
        condition: HaveItem("washed_malachite", 3),
        reward_points: 1,
    ),
    Goal(
        id: "t0_lab",
        tier: 0,
        title: "Build a lab",
        text: "Build a basic lab. A lab uses research kits to research technologies. More labs research faster.",
        condition: Build("basic_lab", 1),
        reward_points: 1,
        waits_for: Some("copper plates (smelting)"),
    ),
    Goal(
        id: "t0_kits",
        tier: 0,
        title: "Make research kits",
        text: "A bronze research kit needs a bronze gear, a raw clay brick and a tin plate. Put the kits in your labs.",
        condition: HaveItem("bronze_kit", 10),
        reward_points: 1,
        waits_for: Some("bronze gears and tin plates (smelting)"),
    ),
    Goal(
        id: "t0_hub",
        tier: 0,
        title: "Repair the Hub",
        text: "The Hub is your landing pod. Open it to see the parts the first repair needs, then deliver them. This opens Tier 1: Steam.",
        condition: Stage(1),
        reward_points: 5,
        waits_for: Some("bronze plates and gears (smelting)"),
    ),
]
