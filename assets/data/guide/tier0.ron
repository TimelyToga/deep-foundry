// Guide goals for Tier 0: Hand and Fire. They follow "a typical first hour"
// (docs/design/01-game-design.md section 4) and chain A (docs/design/02-content.md section 7).
// Goals show in this order. Fields: see crates/factory/src/progress/guide.rs.
[
    Goal(
        id: "t0_dig",
        tier: 0,
        title: "Dig",
        text: "Hold the left mouse button to dig. The cells you dig go into your material tank. Dig 100 units of sand.",
        condition: HaveItem("sand", 100),
        reward_points: 1,
    ),
    Goal(
        id: "t0_clay",
        tier: 0,
        title: "Find clay",
        text: "Clay is a brown powder. Look near water and under the dirt. You make bricks from clay. Dig 64 units of clay.",
        condition: HaveItem("clay", 64),
        reward_points: 1,
    ),
    Goal(
        id: "t0_wood",
        tier: 0,
        title: "Cut a tree",
        text: "Dig the trunk of a tree to get wood. Wood is fuel, and your first buildings are made of it. Collect 60 units of wood.",
        condition: HaveItem("wood", 60),
        reward_points: 1,
    ),
    Goal(
        id: "t0_workbench",
        tier: 0,
        title: "Build a workbench",
        text: "Open the crafting menu and make a workbench from 20 wood. Place it. Hand crafting is 2 times faster near a workbench.",
        condition: Build("workbench", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t0_copper_ore",
        tier: 0,
        title: "Find copper ore",
        text: "Malachite is a green copper ore near the surface. Dig some and hold {key:scan} over it to scan it. Each new material you scan gives a discovery point.",
        condition: Discover("malachite"),
        reward_points: 1,
    ),
    Goal(
        id: "t0_tin_ore",
        tier: 0,
        title: "Find tin ore",
        text: "Cassiterite is a dark tin ore. Look for it in the gravel of river beds. Dig some and scan it with F.",
        condition: Discover("cassiterite"),
        reward_points: 1,
    ),
    Goal(
        id: "t0_raw_bricks",
        tier: 0,
        title: "Make raw clay bricks",
        text: "Make raw clay bricks by hand. Each one needs 16 units of clay. Heat turns them into hard clay bricks.",
        condition: HaveItem("raw_clay_brick", 8),
        reward_points: 1,
    ),
    Goal(
        id: "t0_campfire",
        tier: 0,
        title: "Light a campfire",
        text: "Build a campfire. Put wood in its hopper and light it with the ignite tool. A campfire heats what is above it.",
        condition: Build("campfire", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t0_kiln",
        tier: 0,
        title: "Build a kiln",
        text: "Build a closed room from clay brick walls. Put a kiln controller in the wall. The controller marks wrong walls in red. A kiln gets much hotter than a campfire.",
        condition: Build("kiln_controller", 1),
        reward_points: 2,
    ),
    Goal(
        id: "t0_charcoal",
        tier: 0,
        title: "Make charcoal",
        text: "Heat wood in the closed kiln with no air. The wood turns into charcoal. You need charcoal to smelt ore.",
        condition: HaveItem("charcoal", 32),
        reward_points: 1,
    ),
    Goal(
        id: "t0_tin",
        tier: 0,
        title: "Smelt tin",
        text: "Put tin ore and charcoal in a crucible over the fire. Tin melts at a low temperature, so this works first. Pour the molten tin into a plate mold. When it cools, it is a tin plate: your first metal part.",
        condition: HaveItem("tin_plate", 4),
        reward_points: 2,
    ),
    Goal(
        id: "t0_bellows",
        tier: 0,
        title: "Build bellows",
        text: "Bellows blow air into the kiln. Water must flow through the wheel of the bellows. With bellows, the kiln gets hot enough to melt copper (1100 °C).",
        condition: Build("bellows", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t0_copper",
        tier: 0,
        title: "Smelt copper",
        text: "Smelt malachite with charcoal in the kiln with bellows. Tap the molten copper into a plate mold.",
        condition: HaveItem("copper_plate", 4),
        reward_points: 2,
    ),
    Goal(
        id: "t0_research_bronze",
        tier: 0,
        title: "Research Bronze",
        text: "Open the tech tree and research Bronze. It needs scans of copper ore and tin ore.",
        condition: Research("bronze"),
        reward_points: 1,
    ),
    Goal(
        id: "t0_bronze",
        tier: 0,
        title: "Make bronze",
        text: "Mix 3 parts molten copper with 1 part molten tin in a crucible above 1000 °C. Cast the molten bronze into plates.",
        condition: HaveItem("bronze_plate", 10),
        reward_points: 2,
    ),
    Goal(
        id: "t0_gears",
        tier: 0,
        title: "Make bronze gears",
        text: "Make bronze gears from bronze plates, or cast them in a gear mold. Machines need gears.",
        condition: HaveItem("bronze_gear", 4),
        reward_points: 1,
    ),
    Goal(
        id: "t0_stamp_mill",
        tier: 0,
        title: "Crush ore",
        text: "Build a stamp mill. Water must flow through its wheel. It crushes ore. Crushed ore gives more metal than raw ore.",
        condition: Build("stamp_mill", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t0_sluice",
        tier: 0,
        title: "Wash ore",
        text: "Build a sluice and let water flow through it. Heavy ore stays in the sluice. Light waste washes out. Washed ore gives even more metal.",
        condition: Build("sluice", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t0_research_labs",
        tier: 0,
        title: "Research labs",
        text: "Research the Research technology. It unlocks the basic lab and bronze research kits.",
        condition: Research("research"),
        reward_points: 1,
    ),
    Goal(
        id: "t0_lab",
        tier: 0,
        title: "Build a lab",
        text: "Build a basic lab. A lab uses research kits to research technologies. More labs research faster.",
        condition: Build("basic_lab", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t0_kits",
        tier: 0,
        title: "Make research kits",
        text: "A bronze research kit needs a bronze gear, a clay brick and a tin plate. Put the kits in your labs.",
        condition: HaveItem("bronze_kit", 10),
        reward_points: 1,
    ),
    Goal(
        id: "t0_hub",
        tier: 0,
        title: "Repair the Hub",
        text: "The Hub is your landing pod. Open it to see the parts the first repair needs, then deliver them. This opens Tier 1: Steam.",
        condition: Stage(1),
        reward_points: 5,
    ),
]
