// Guide goals for Tier 0: Hand and Fire. They follow "a typical first hour"
// (docs/design/01-game-design.md section 4) and chain A (docs/design/02-content.md section 7).
// Goals show in this order. Fields: see crates/factory/src/progress/guide.rs.
//
// Texts: say what to do, where, and with which key or button. Write keys as {key:ID} (all keys
// of the action, for example "A / Left") or {key1:ID} (the first key only), with the ids of
// crates/game/src/keys.rs. Never write a fixed letter: the player can change the keys, and on a
// Dvorak keyboard the letters are in other places. Mouse buttons are fixed.
//
// Resource directions describe the generated temperate starting area. Deposits and terrain
// vary with the seed; the scanner identifies the material under the pointer.
//
// `waits_for`: the machine or game part that the goal needs and that the game does not have yet
// (for example "the kiln"). The guide shows the goal gray, and when no other goal is open it says
// "Next: the kiln. It comes in a later update." Goals that the game can do come first. Remove
// `waits_for` when the game can do the goal; the test `tier0_goals_can_be_done`
// (crates/game/src/tier0_tests.rs) then needs a script for the goal.
[
    Goal(
        id: "t0_dig",
        tier: 0,
        title: "Dig sand",
        text: "Look for the pale sand patch just left of the Hub, or sand along a nearby shore. Move with {key:move_left} and {key:move_right}. Point at the sand and hold the left mouse button to dig. The sand goes into your material tanks (the panel right of the quickbar). Dig 100 units of sand.",
        condition: HaveItem("sand", 100),
        reward_points: 1,
    ),
    Goal(
        id: "t0_clay",
        tier: 0,
        title: "Find clay",
        text: "Clay is a gray-brown powder just below the ground left of the Hub, past the sand. There is more clay right of the Hub, past the tin ore bed, and under the gravel of lakes and rivers. Hold the left mouse button on it to dig it. The robot keeps clay and throws plain dirt out behind itself. Dig 64 units of clay.",
        condition: HaveItem("clay", 64),
        reward_points: 1,
    ),
    Goal(
        id: "t0_wood",
        tier: 0,
        title: "Collect wood",
        text: "Woods grow on both sides of the Hub. Dig the wooden trunks. Walk with {key:move_left} and {key:move_right}; jump with {key1:jump} and hold it to fly over obstacles. You start with 30 wood. Have 60 units of wood. Keep the flat ground right of the Hub free: it is a good place to build.",
        condition: HaveItem("wood", 60),
        reward_points: 1,
    ),
    Goal(
        id: "t0_workbench",
        tier: 0,
        title: "Build a workbench",
        text: "Press {key:character} to open the character screen. In the Production tab, click Workbench (20 wood). The workbench goes to your quickbar: click it there, then left click on the ground near you to place it. Near a workbench, hand crafting is 2 times faster.",
        condition: Build("workbench", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t0_copper_ore",
        tier: 0,
        title: "Find copper ore",
        text: "Malachite is a green copper ore. There are deposits a little below the ground about 40 tiles left and 40 tiles right of the Hub, and one more far left, near the lake. Dig it with the left mouse button, or point at it and hold {key:scan} to scan it. Each new material that you dig or scan gives a discovery point.",
        condition: Discover("malachite"),
        reward_points: 1,
    ),
    Goal(
        id: "t0_tin_ore",
        tier: 0,
        title: "Find tin ore",
        text: "Cassiterite is a dark tin ore mixed into gravel. There is a bed of it a little below the ground about 30 tiles right of the Hub, one near the lake on the left, and more in the gravel of the river bed. Dig it with the left mouse button, or point at it and hold {key:scan}.",
        condition: Discover("cassiterite"),
        reward_points: 1,
    ),
    Goal(
        id: "t0_research_bronze",
        tier: 0,
        title: "Research Bronze",
        text: "Press {key:research} to open the research window. Click Research on Bronze. Bronze needs the discovery of copper ore and tin ore: find malachite and cassiterite first.",
        condition: Research("bronze"),
        reward_points: 1,
    ),
    Goal(
        id: "t0_raw_bricks",
        tier: 0,
        title: "Make raw clay bricks",
        text: "Press {key:character}. In the Intermediate tab, click Raw clay brick: a click makes 1, a right click makes 5. Each brick needs 16 clay, so 8 bricks need 128 clay. Make 8 raw clay bricks.",
        condition: HaveItem("raw_clay_brick", 8),
        reward_points: 1,
    ),
    Goal(
        id: "t0_campfire",
        tier: 0,
        title: "Build a campfire",
        text: "Press {key:character}. In the Power tab, click Campfire (10 wood). Click the campfire on your quickbar, then left click on the ground near you to place it.",
        condition: Build("campfire", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t0_fire_bricks",
        tier: 0,
        title: "Fire clay bricks",
        text: "Left click the campfire to open it. Shift + click your raw clay bricks to put them in. Click your wood tank on the bar at the bottom: the wood goes into the fuel slot. The fire bakes one clay brick in 30 seconds and burns 6 wood for it. Click the output slot to take the bricks. Have 8 clay bricks.",
        condition: HaveItem("clay_brick", 8),
        reward_points: 2,
    ),
    Goal(
        id: "t0_sluice",
        tier: 0,
        title: "Build a sluice",
        text: "Build a sluice and place it beside a water source. Its side inlet takes crushed ore, the top inlet takes water, and its three outlets separate washed ore from light silt and used water.",
        condition: Build("sluice", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t0_research_labs",
        tier: 0,
        title: "Research labs",
        text: "Press {key:research} and click Research on Research. It unlocks the basic lab and bronze research kits.",
        condition: Research("research"),
        reward_points: 1,
    ),

    Goal(
        id: "t0_kiln",
        tier: 0,
        title: "Build a kiln",
        text: "A kiln is a closed room of clay brick walls. It needs 24 clay bricks: fire more in the campfire. Press {key:character} and craft a kiln controller and a kiln hatch (Production tab) and 6 clay brick walls (Logistics tab). Place them as a ring of 3 by 3 tiles: the controller in a side wall, the hatch in the roof, the walls on the other 6 tiles. The middle tile stays empty: that is the room. Left click the controller: its window says if the room is closed, or where it has a hole.",
        condition: Build("kiln_controller", 1),
        reward_points: 2,
    ),
    Goal(
        id: "t0_charcoal",
        tier: 0,
        title: "Make charcoal",
        text: "Left click the kiln controller. Click the recipe slot and choose Charcoal. Click your wood tank on the bar at the bottom: the wood goes into the input and into the fuel slot. The fuel burns on the floor of the room and heats it. Charcoal needs 300 °C; a wood fire makes about 700 °C. Click the output slot to take the charcoal. Have 32 charcoal.",
        condition: HaveItem("charcoal", 32),
        reward_points: 1,
    ),

    // --- Metal: the crucible, bronze, ore processing, research, the Hub ---
    Goal(
        id: "t0_tin",
        tier: 0,
        title: "Smelt tin",
        text: "Craft a crucible (4 raw clay bricks), a plate mold (4 clay bricks), a campfire and a crate. Place the campfire on flat ground. Place the crucible on top of it: the left half of the crucible must be over the fire. Leave one empty tile right of the campfire, and place the plate mold right of that tile, under the tap of the crucible. Place the crate right of the mold. Open the campfire and click your wood tank: the wood is its fuel. Open the crucible, choose Molten tin and click your cassiterite tank and your charcoal tank. At 900 °C it smelts. The molten tin pours onto the mold, the mold makes tin plates when it cools, and the plates go into the crate. Have 4 tin plates.",
        condition: HaveItem("tin_plate", 4),
        reward_points: 2,
    ),
    Goal(
        id: "t0_bellows",
        tier: 0,
        title: "Build bellows",
        text: "Craft bellows (10 wood, 2 tin plates). Place them at most 3 tiles from the campfire. Bellows blow air into the fire: it gets 300 °C hotter. Copper needs 1100 °C, so it needs the bellows. Do not put wood buildings right next to the fire: they burn.",
        condition: Build("bellows", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t0_copper",
        tier: 0,
        title: "Smelt copper",
        text: "Open the plate mold and choose Copper plate. Open the crucible, choose Molten copper and click your malachite tank and your charcoal tank. With the bellows near the fire, the crucible gets to 1100 °C and smelts the copper. Have 4 copper plates.",
        condition: HaveItem("copper_plate", 4),
        reward_points: 2,
    ),
    Goal(
        id: "t0_bronze",
        tier: 0,
        title: "Make bronze",
        text: "Open the plate mold and choose Bronze plate. Open the crucible and choose Molten bronze. Shift + left click your copper plates and your tin plates: 3 copper plates and 1 tin plate melt into 4 bronze plates at 1000 °C. Have 10 bronze plates.",
        condition: HaveItem("bronze_plate", 10),
        reward_points: 2,
    ),
    Goal(
        id: "t0_gears",
        tier: 0,
        title: "Make bronze gears",
        text: "Press {key:character} and craft bronze gears. A gear needs 2 bronze plates. Machines need gears. Have 4 bronze gears.",
        condition: HaveItem("bronze_gear", 4),
        reward_points: 1,
    ),
    Goal(
        id: "t0_stamp_mill",
        tier: 0,
        title: "Crush ore",
        text: "Craft a stamp mill (30 wood, 4 bronze gears) and place it. Open it, choose Crushed malachite and click your malachite tank. Crushed ore gives more metal in the crucible: 20 units from 16 ore, not 16. A hopper on top of the mill feeds it, and a crate at its output port collects the crushed ore. Have 16 crushed malachite.",
        condition: HaveItem("crushed_malachite", 16),
        reward_points: 1,
    ),
    Goal(
        id: "t0_wash_ore",
        tier: 0,
        title: "Wash ore",
        text: "Open the sluice, choose Washed malachite, and click your crushed malachite tank and your water tank. Water comes in at its top inlet. Washed ore gives the most metal: 24 units from 16 ore. Have 3 washed malachite.",
        condition: HaveItem("washed_malachite", 3),
        reward_points: 1,
    ),
    Goal(
        id: "t0_lab",
        tier: 0,
        title: "Build a lab",
        text: "Craft a basic lab (20 wood, 4 copper plates, 4 clay bricks) and place it. Fire clay bricks fast in the kiln: open the kiln controller, choose Clay brick, shift + left click your raw clay bricks and click your charcoal tank (the fuel). A lab uses research kits to research technologies.",
        condition: Build("basic_lab", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t0_kits",
        tier: 0,
        title: "Make research kits",
        text: "Press {key:character} and craft bronze research kits. One craft needs 1 bronze gear, 1 tin plate and 1 raw clay brick, and makes 2 kits. Have 10 kits. Put them in the lab: shift + left click them with the lab window open.",
        condition: HaveItem("bronze_kit", 10),
        reward_points: 1,
    ),
    Goal(
        id: "t0_hub",
        tier: 0,
        title: "Repair the Hub",
        text: "Open the Hub and shift + left click the parts it needs: 16 bronze plates, 8 bronze gears and 32 clay bricks. The repair opens Tier 1: Steam.",
        condition: Stage(1),
        reward_points: 5,
    ),
]
