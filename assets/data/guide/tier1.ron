// Guide goals for Tier 1: Steam. They follow chains B, C and D
// (docs/design/02-content.md section 7) and the Tier 1 research list (section 8).
// Goals show in this order. Fields: see crates/factory/src/progress/guide.rs.
// Texts: say what to do, where, and with which key or button (see tier0.ron).
[
    Goal(
        id: "t1_drill_head",
        tier: 1,
        title: "Dig into stone",
        text: "Press {key:research} and research Bronze drill head. It needs bronze research kits in a lab. With it you can dig stone, iron ore and limestone.",
        condition: Research("bronze_drill_head"),
        reward_points: 1,
    ),
    Goal(
        id: "t1_boiler",
        tier: 1,
        title: "Make steam",
        text: "Research Steam power and craft a small boiler. Put fuel in its top input: coal, coke, charcoal or wood. Water: place bronze pipes from its water port (left) into a lake or a river. A pipe in water takes the water in. Do not let a hot boiler run dry: cold water in a dry, hot boiler makes it explode.",
        condition: Build("small_boiler", 1),
        reward_points: 2,
    ),
    Goal(
        id: "t1_steam_crusher",
        tier: 1,
        title: "Steam machines",
        text: "Research Steam machines and build a steam crusher. Place bronze pipes from the steam port of the boiler (right) to the steam port of the crusher. A pipe must be on the tile of the port. Feed ore into its top; the crushed ore comes out below.",
        condition: Build("steam_crusher", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t1_arm",
        tier: 1,
        title: "Move items with arms",
        text: "Research Automation and build arms. An arm takes items from the building on its left and puts them into the building on its right. Press {key:rotate} to turn it before you place it. Use arms to move plates from a crate into a machine and the products into another crate.",
        condition: Build("arm", 2),
        reward_points: 1,
    ),
    Goal(
        id: "t1_assembler",
        tier: 1,
        title: "Automate research kits",
        text: "Build a steam assembler and give it steam. Choose Bronze research kit. Put bronze gears, tin plates and raw clay bricks into a crate, and place an arm from the crate into the assembler and an arm from the assembler into your lab. The lab gets kits with no work from you.",
        condition: Build("steam_assembler", 1),
        reward_points: 2,
    ),
    Goal(
        id: "t1_steam_furnace",
        tier: 1,
        title: "Smelt with steam",
        text: "Research Steam smelting and build a steam furnace. It smelts ore with no fire and makes bronze from plates. Put a hopper with ore and charcoal on its top, or feed it with arms. Place a plate mold right of the furnace, under its tap, and a crate right of the mold.",
        condition: Build("steam_furnace", 1),
        reward_points: 2,
    ),
    Goal(
        id: "t1_iron_ore",
        tier: 1,
        title: "Find iron ore",
        text: "There is red hematite (iron ore) in the ground right of the river, about 90 tiles right of the Hub, 4 tiles down. More iron ore (black magnetite or red hematite) is in the stone layer. Dig some, or point at it and hold {key:scan} to scan it.",
        condition: Any([Discover("raw_magnetite"), Discover("raw_hematite")]),
        reward_points: 1,
    ),
    Goal(
        id: "t1_steam_drill",
        tier: 1,
        title: "Mine with steam",
        text: "Research Steam mining and build a steam drill on top of an ore deposit. It digs the ground under it, 6 tiles deep, and puts the ore out of its right port: into a crate, a hopper or onto a belt. Give it steam.",
        condition: Build("steam_drill", 1),
        reward_points: 2,
    ),
    Goal(
        id: "t1_coal",
        tier: 1,
        title: "Find coal",
        text: "There is a coal seam in the ground about 120 tiles right of the Hub. More coal is in the stone layer. Dig 200 units of coal.",
        condition: HaveItem("raw_coal", 200),
        reward_points: 1,
    ),
    Goal(
        id: "t1_coke_oven",
        tier: 1,
        title: "Build a coke oven",
        text: "Build a closed room from firebrick walls with a coke oven controller and a coke oven hatch. Coal that is heated with no air turns into coke. The oven also makes creosote (a liquid) and coal gas.",
        condition: Build("coke_oven_controller", 1),
        reward_points: 2,
    ),
    Goal(
        id: "t1_coke",
        tier: 1,
        title: "Make coke",
        text: "Open the coke oven controller, choose Coke and put coal in. Take the coke out at the hatches. The blast furnace needs coke to turn iron ore into iron.",
        condition: HaveItem("coke", 100),
        reward_points: 1,
    ),
    Goal(
        id: "t1_limestone",
        tier: 1,
        title: "Crush limestone",
        text: "There is limestone in the ground about 50 tiles left of the Hub, 5 tiles down. Mine it and crush it in a steam crusher. In the blast furnace, limestone takes the waste out of the iron as slag.",
        condition: HaveItem("crushed_limestone", 100),
        reward_points: 1,
    ),
    Goal(
        id: "t1_blast_furnace",
        tier: 1,
        title: "Build a blast furnace",
        text: "Build a closed room from firebrick walls with a blast furnace controller and blast furnace hatches. Put a steam blower in the wall and give it steam: it blows air into the fire, which gets hot enough for iron. Put crushed iron ore, coke and crushed limestone in at the top.",
        condition: Build("blast_furnace_controller", 1),
        reward_points: 3,
    ),
    Goal(
        id: "t1_pig_iron",
        tier: 1,
        title: "Tap the iron",
        text: "Molten pig iron collects at the bottom of the blast furnace. Molten slag floats on it. Put a hatch low in the wall for the iron and one higher for the slag, with a barrel outside each. Point at the molten iron and hold {key:scan} to scan it.",
        condition: Discover("molten_pig_iron"),
        reward_points: 2,
    ),
    Goal(
        id: "t1_steel",
        tier: 1,
        title: "Make steel",
        text: "Build a steel converter and give it steam. An arm moves molten pig iron from a barrel into it. Its tap at the bottom pours molten steel into a plate mold under it, and the slag comes out of its side port.",
        condition: HaveItem("steel_plate", 20),
        reward_points: 2,
    ),
    Goal(
        id: "t1_slag",
        tier: 1,
        title: "Use the slag",
        text: "Every process makes something extra. The steel converter gives crushed slag, and the steam crusher crushes the slag from the blast furnace. Crushed slag and quicklime make cement. Cement makes concrete.",
        condition: HaveItem("crushed_slag", 100),
        reward_points: 1,
    ),
    Goal(
        id: "t1_creosote",
        tier: 1,
        title: "Collect creosote",
        text: "Collect the creosote from the coke oven in barrels. Soak wood blocks in it to make treated wood, which does not burn easily. You can also burn creosote as fuel.",
        condition: HaveItem("creosote", 100),
        reward_points: 1,
    ),
    Goal(
        id: "t1_glass",
        tier: 1,
        title: "Make glass",
        text: "Research Glass. A steam furnace (or a kiln at 1100 °C) melts 16 sand and 4 ash into molten glass. Ash comes from burned wood. Put a vial mold under the tap.",
        condition: HaveItem("glass_vial", 10),
        reward_points: 2,
    ),
    Goal(
        id: "t1_rubber",
        tier: 1,
        title: "Make rubber",
        text: "Rubber trees grow in the woods far from the Hub: their trunks are rubber tree wood. A steam extractor turns rubber tree wood into resin. Heat resin to 150 °C to make rubber. A steam press makes rubber sheets.",
        condition: HaveItem("rubber_sheet", 10),
        reward_points: 2,
    ),
    Goal(
        id: "t1_iron_belts",
        tier: 1,
        title: "Faster belts",
        text: "Research Iron logistics. Iron belts move 16 cells per second, 2 times faster than wood belts, and they do not burn.",
        condition: Build("iron_belt", 20),
        reward_points: 1,
    ),
    Goal(
        id: "t1_steam_kits",
        tier: 1,
        title: "Make steam kits",
        text: "A steam research kit needs a steel plate, a bronze pipe section and a glass vial. A steam assembler makes them: feed it with arms.",
        condition: HaveItem("steam_kit", 10),
        reward_points: 1,
    ),
    Goal(
        id: "t1_steam_lab",
        tier: 1,
        title: "Build a steam lab",
        text: "A steam lab uses bronze kits and steam kits. Tier 1 technologies need both, so keep your bronze kit line working.",
        condition: Build("steam_lab", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t1_hub",
        tier: 1,
        title: "Repair the Hub power core",
        text: "Open the Hub to see the parts the second repair needs: steel plates, copper wires, glass panes and rubber sheets. Deliver them. This opens Tier 2: LV.",
        condition: Stage(2),
        reward_points: 5,
    ),
]
