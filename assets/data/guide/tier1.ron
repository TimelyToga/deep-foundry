// Guide goals for Tier 1: Steam. They follow chains B, C and D
// (docs/design/02-content.md section 7) and the Tier 1 research list (section 8).
// Goals show in this order. Fields: see crates/factory/src/progress/guide.rs.
[
    Goal(
        id: "t1_boiler",
        tier: 1,
        title: "Make steam",
        text: "Build a small boiler. It burns fuel and turns water into steam. Steam machines take steam from pipes. Do not let a hot boiler run dry: cold water in a dry, hot boiler makes it explode.",
        condition: Build("small_boiler", 1),
        reward_points: 2,
    ),
    Goal(
        id: "t1_steam_crusher",
        tier: 1,
        title: "Steam machines",
        text: "Build a steam crusher and feed it ore. It crushes ore faster than the stamp mill.",
        condition: Build("steam_crusher", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t1_drill_head",
        tier: 1,
        title: "Dig into stone",
        text: "Research the bronze drill head. With it you can dig stone and go down into the upper stone layer.",
        condition: Research("bronze_drill_head"),
        reward_points: 1,
    ),
    Goal(
        id: "t1_iron_ore",
        tier: 1,
        title: "Find iron ore",
        text: "Look in the stone for iron ore: black magnetite or red hematite. Dig some and scan it with F.",
        condition: Any([Discover("raw_magnetite"), Discover("raw_hematite")]),
        reward_points: 1,
    ),
    Goal(
        id: "t1_coal",
        tier: 1,
        title: "Find coal",
        text: "Coal is a black rock in the stone layer. You make coke from it. Dig 200 units of coal.",
        condition: HaveItem("raw_coal", 200),
        reward_points: 1,
    ),
    Goal(
        id: "t1_coke_oven",
        tier: 1,
        title: "Build a coke oven",
        text: "Build a closed room from brick walls with a coke oven controller. Coal that is heated with no air turns into coke. The oven also makes creosote (a liquid) and coal gas.",
        condition: Build("coke_oven_controller", 1),
        reward_points: 2,
    ),
    Goal(
        id: "t1_coke",
        tier: 1,
        title: "Make coke",
        text: "Take the coke out of the coke oven. The blast furnace needs coke to turn iron ore into iron.",
        condition: HaveItem("coke", 100),
        reward_points: 1,
    ),
    Goal(
        id: "t1_limestone",
        tier: 1,
        title: "Crush limestone",
        text: "Mine limestone and crush it. In the blast furnace, limestone takes the waste out of the iron as slag.",
        condition: HaveItem("crushed_limestone", 100),
        reward_points: 1,
    ),
    Goal(
        id: "t1_blast_furnace",
        tier: 1,
        title: "Build a blast furnace",
        text: "Build a closed room from firebrick with a blast furnace controller. Put ore, coke and limestone in at the top. Blow hot air in at the bottom with a steam blower.",
        condition: Build("blast_furnace_controller", 1),
        reward_points: 3,
    ),
    Goal(
        id: "t1_pig_iron",
        tier: 1,
        title: "Tap the iron",
        text: "Molten pig iron collects at the bottom of the blast furnace. Molten slag floats on it. Put the iron tap low and the slag tap higher. If slag gets into the iron molds, the parts are scrap. Scan the molten iron with F.",
        condition: Discover("molten_pig_iron"),
        reward_points: 2,
    ),
    Goal(
        id: "t1_steel",
        tier: 1,
        title: "Make steel",
        text: "Build a steel converter. It blows air through molten pig iron and makes molten steel. Cast the steel into plates.",
        condition: HaveItem("steel_plate", 20),
        reward_points: 2,
    ),
    Goal(
        id: "t1_slag",
        tier: 1,
        title: "Use the slag",
        text: "Every process makes something extra. Crush the slag from the blast furnace. Crushed slag and quicklime make cement. Cement makes concrete.",
        condition: HaveItem("crushed_slag", 100),
        reward_points: 1,
    ),
    Goal(
        id: "t1_creosote",
        tier: 1,
        title: "Collect creosote",
        text: "Collect the creosote from the coke oven. Soak wood blocks in it to make treated wood, which does not burn easily. You can also burn creosote as fuel.",
        condition: HaveItem("creosote", 100),
        reward_points: 1,
    ),
    Goal(
        id: "t1_glass",
        tier: 1,
        title: "Make glass",
        text: "Research Glass. Heat sand and ash to 1100 °C to make molten glass. Ash comes from burned wood. Cast the glass in a vial mold.",
        condition: HaveItem("glass_vial", 10),
        reward_points: 2,
    ),
    Goal(
        id: "t1_rubber",
        tier: 1,
        title: "Make rubber",
        text: "Cut rubber trees in the swamp. A steam extractor turns rubber tree wood into resin. Heat resin to 150 °C to make rubber. A steam press makes rubber sheets.",
        condition: HaveItem("rubber_sheet", 10),
        reward_points: 2,
    ),
    Goal(
        id: "t1_iron_belts",
        tier: 1,
        title: "Faster belts",
        text: "Research Iron logistics. Iron belts move 16 cells per second, 2 times faster than wood belts, and they do not burn.",
        condition: Build("iron_belt", 20),
        reward_points: 1,
    ),
    Goal(
        id: "t1_steam_kits",
        tier: 1,
        title: "Make steam kits",
        text: "A steam research kit needs a steel plate, a bronze pipe section and a glass vial. A steam assembler makes them.",
        condition: HaveItem("steam_kit", 10),
        reward_points: 1,
    ),
    Goal(
        id: "t1_steam_lab",
        tier: 1,
        title: "Build a steam lab",
        text: "A steam lab uses bronze kits and steam kits. Tier 1 technologies need both, so keep your bronze kit line working.",
        condition: Build("steam_lab", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t1_hub",
        tier: 1,
        title: "Repair the Hub power core",
        text: "Open the Hub to see the parts the second repair needs: steel plates, copper wires, glass panes and rubber sheets. Deliver them. This opens Tier 2: LV.",
        condition: Stage(2),
        reward_points: 5,
    ),
]
