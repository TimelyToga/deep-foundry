// Guide goals for Tier 2: LV electric power. Fields: see crates/factory/src/progress/guide.rs.
// Texts: say what to do, where, and with which key or button (see tier0.ron).
[
    Goal(
        id: "t2_electricity",
        tier: 2,
        title: "Research electricity",
        text: "Press {key:research} and research Electricity. It needs bronze kits and steam kits in a steam lab.",
        condition: Research("electricity"),
        reward_points: 2,
    ),
    Goal(
        id: "t2_turbine",
        tier: 2,
        title: "Make electric power",
        text: "Build a steam turbine and give it steam from a bronze pipe at its steam port. It makes up to 12 kW from 6 steam per second: about one small boiler's steam.",
        condition: Build("steam_turbine", 1),
        reward_points: 2,
    ),
    Goal(
        id: "t2_cables",
        tier: 2,
        title: "Lay cables",
        text: "Craft copper cables (copper wire and rubber sheets) and place them in the back layer, from the power port of the turbine to the power ports of your machines. Cables next to each other are one network.",
        condition: Build("copper_cable", 10),
        reward_points: 1,
    ),
    Goal(
        id: "t2_motors",
        tier: 2,
        title: "Make electric motors",
        text: "An electric motor needs a steel plate, 8 copper wires and a bronze gear. Electric machines need motors: make them in an assembler with arms.",
        condition: HaveItem("electric_motor", 10),
        reward_points: 1,
    ),
    Goal(
        id: "t2_macerator",
        tier: 2,
        title: "Crush with electricity",
        text: "Research LV machines and build a macerator on your cable network. It crushes ore 4 times faster than the stamp mill. If the turbine cannot make enough power, every machine on the network slows down.",
        condition: Build("macerator", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t2_electric_furnace",
        tier: 2,
        title: "Electric smelting",
        text: "Build an electric furnace on the network. It smelts, makes bronze and melts glass fast, with no fuel.",
        condition: Build("electric_furnace", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t2_electric_assembler",
        tier: 2,
        title: "Electric assembly",
        text: "Build an electric assembler and let it make research kits or motors. Fast arms (a cable behind each) keep it fed.",
        condition: Build("electric_assembler", 1),
        reward_points: 1,
    ),
    Goal(
        id: "t2_electric_drill",
        tier: 2,
        title: "Mine with electricity",
        text: "Research Electric mining and build an electric drill on a deposit. It digs 10 tiles deep, also hard rock.",
        condition: Build("electric_drill", 1),
        reward_points: 2,
    ),
    Goal(
        id: "t2_gold",
        tier: 2,
        title: "Find gold",
        text: "Dig down into the granite, more than 1700 cells (about 210 tiles) down. Look for native gold: small deposits in the rock, and rich deposits in the walls of deep caves. Dig it with the left mouse button, or point at it and hold {key:scan}. Then research Gold.",
        condition: Research("gold"),
        reward_points: 3,
    ),
    Goal(
        id: "t2_circuits",
        tier: 2,
        title: "Make circuits",
        text: "Smelt raw gold in a furnace (16 raw gold and 4 charcoal) and cast gold plates in a plate mold. Draw the plates into gold wire. A circuit needs 2 gold wires, a glass pane and a rubber sheet.",
        condition: HaveItem("circuit", 4),
        reward_points: 2,
    ),
    Goal(
        id: "t2_battery",
        tier: 2,
        title: "Store power",
        text: "Research Batteries and build a battery with a copper cable behind its power port. It stores the power your turbines can make but your machines do not use, and gives it back when they need more. Open the power window to see how full it is.",
        condition: Build("battery", 1),
        reward_points: 2,
    ),
]
