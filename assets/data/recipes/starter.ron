    // Water washes crushed ore: the clean fraction leaves through the product port while light
    // silt exits with the flowing water through its own tailings port.
    Recipe(id: "washed_malachite", category: "washing", inputs: [("crushed_malachite", 4), ("water", 1)], outputs: [("washed_malachite", 3), ("water", 1)], byproducts: [(item: "silt", count: 1, chance: 1.0)], time: 2.0),
    Recipe(id: "washed_cassiterite", category: "washing", inputs: [("crushed_cassiterite", 4), ("water", 1)], outputs: [("washed_cassiterite", 3), ("water", 1)], byproducts: [(item: "silt", count: 1, chance: 1.0)], time: 2.0),
    Recipe(id: "washed_coal", category: "washing", inputs: [("crushed_coal", 4), ("water", 1)], outputs: [("washed_coal", 3), ("water", 1)], byproducts: [(item: "silt", count: 1, chance: 1.0)], time: 2.0),
    Recipe(id: "washed_magnetite", category: "washing", inputs: [("crushed_magnetite", 4), ("water", 1)], outputs: [("washed_magnetite", 3), ("water", 1)], byproducts: [(item: "silt", count: 1, chance: 1.0)], time: 2.0),
    Recipe(id: "washed_hematite", category: "washing", inputs: [("crushed_hematite", 4), ("water", 1)], outputs: [("washed_hematite", 3), ("water", 1)], byproducts: [(item: "silt", count: 1, chance: 1.0)], time: 2.0),
