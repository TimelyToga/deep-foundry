// Tier 0-1 recipes. Items are (id, count): materials count in units (cells), parts in pieces.
// See docs/design/02-content.md section 6.
[
    // --- Building recipes: known from the start (no tech unlocks them) ---
    Recipe(id: "workbench", category: "hand", inputs: [("wood", 20)], outputs: [("workbench", 1)], time: 3.0),
