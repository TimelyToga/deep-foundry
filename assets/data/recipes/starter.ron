    // --- Tier 0 intermediates: known from the start ---
    Recipe(id: "raw_clay_brick", category: "hand", inputs: [("clay", 16)], outputs: [("raw_clay_brick", 1)], time: 1.0),
    Recipe(id: "clay_brick", name: Some("Clay brick"), category: "kiln", inputs: [("raw_clay_brick", 1)], outputs: [("clay_brick", 1)], time: 20.0, min_temp: Some(900)),
    // Pit firing: the campfire bakes raw clay bricks slowly with wood as fuel (its fuel slot).
    // So the first clay bricks (and the kiln that needs them) do not need a kiln.
    Recipe(id: "pit_fired_clay_brick", name: Some("Clay brick (campfire)"), category: "pit_firing", inputs: [("raw_clay_brick", 1)], outputs: [("clay_brick", 1)], time: 30.0),
    Recipe(id: "raw_firebrick", category: "hand", inputs: [("clay", 12), ("sand", 4)], outputs: [("raw_firebrick", 1)], time: 1.0),
    Recipe(id: "firebrick", name: Some("Firebrick"), category: "kiln", inputs: [("raw_firebrick", 1)], outputs: [("firebrick", 1)], time: 30.0, min_temp: Some(1200)),
    Recipe(id: "charcoal", category: "kiln", inputs: [("wood", 32)], outputs: [("charcoal", 24)], byproducts: [(item: "smoke", count: 8, chance: 1.0)], time: 30.0, min_temp: Some(300)),
    // Smelting in the kiln (docs/design/02-content.md section 6, game design section 16): 16 ore
    // units hold 24 metal units; raw ore gives 8, crushed ore 11, washed ore 14. Copper needs
    // 1100 degrees C: a charcoal fire with bellows. The molten metal leaves through a tap.
    Recipe(id: "kiln_tin_raw", name: Some("Molten tin (raw ore)"), category: "kiln", inputs: [("raw_cassiterite", 16), ("charcoal", 4)], outputs: [("molten_tin", 8)], byproducts: [(item: "molten_slag", count: 4, chance: 1.0), (item: "carbon_dioxide", count: 2, chance: 1.0)], time: 10.0, min_temp: Some(900)),
    Recipe(id: "kiln_tin_crushed", name: Some("Molten tin (crushed ore)"), category: "kiln", inputs: [("crushed_cassiterite", 16), ("charcoal", 4)], outputs: [("molten_tin", 11)], byproducts: [(item: "molten_slag", count: 2, chance: 1.0), (item: "carbon_dioxide", count: 2, chance: 1.0)], time: 10.0, min_temp: Some(900)),
    Recipe(id: "kiln_tin_washed", name: Some("Molten tin (washed ore)"), category: "kiln", inputs: [("washed_cassiterite", 16), ("charcoal", 4)], outputs: [("molten_tin", 14)], byproducts: [(item: "carbon_dioxide", count: 2, chance: 1.0)], time: 10.0, min_temp: Some(900)),
    Recipe(id: "kiln_copper_raw", name: Some("Molten copper (raw ore)"), category: "kiln", inputs: [("raw_malachite", 16), ("charcoal", 4)], outputs: [("molten_copper", 8)], byproducts: [(item: "molten_slag", count: 4, chance: 1.0), (item: "carbon_dioxide", count: 2, chance: 1.0)], time: 12.0, min_temp: Some(1100)),
    Recipe(id: "kiln_copper_crushed", name: Some("Molten copper (crushed ore)"), category: "kiln", inputs: [("crushed_malachite", 16), ("charcoal", 4)], outputs: [("molten_copper", 11)], byproducts: [(item: "molten_slag", count: 2, chance: 1.0), (item: "carbon_dioxide", count: 2, chance: 1.0)], time: 12.0, min_temp: Some(1100)),
    Recipe(id: "kiln_copper_washed", name: Some("Molten copper (washed ore)"), category: "kiln", inputs: [("washed_malachite", 16), ("charcoal", 4)], outputs: [("molten_copper", 14)], byproducts: [(item: "carbon_dioxide", count: 2, chance: 1.0)], time: 12.0, min_temp: Some(1100)),
    Recipe(id: "tin_plate", category: "casting_plate", inputs: [("molten_tin", 16)], outputs: [("tin_plate", 1)], time: 6.0),
    Recipe(id: "copper_plate", category: "casting_plate", inputs: [("molten_copper", 16)], outputs: [("copper_plate", 1)], time: 8.0),
    // The crucible: 16 ore and 4 charcoal give 16 units of metal (one plate) from raw ore, 20 from
    // crushed ore and 24 from washed ore. Ore processing (stamp mill, sluice) pays off.
    Recipe(id: "tin_smelting", name: Some("Molten tin (raw ore)"), category: "crucible_smelting", inputs: [("raw_cassiterite", 16), ("charcoal", 4)], outputs: [("molten_tin", 16)], time: 8.0, min_temp: Some(900)),
    Recipe(id: "tin_smelting_crushed", name: Some("Molten tin (crushed ore)"), category: "crucible_smelting", inputs: [("crushed_cassiterite", 16), ("charcoal", 4)], outputs: [("molten_tin", 20)], time: 8.0, min_temp: Some(900)),
    Recipe(id: "tin_smelting_washed", name: Some("Molten tin (washed ore)"), category: "crucible_smelting", inputs: [("washed_cassiterite", 16), ("charcoal", 4)], outputs: [("molten_tin", 24)], time: 8.0, min_temp: Some(900)),
    Recipe(id: "copper_smelting", name: Some("Molten copper (raw ore)"), category: "crucible_smelting", inputs: [("raw_malachite", 16), ("charcoal", 4)], outputs: [("molten_copper", 16)], time: 10.0, min_temp: Some(1100)),
    Recipe(id: "copper_smelting_crushed", name: Some("Molten copper (crushed ore)"), category: "crucible_smelting", inputs: [("crushed_malachite", 16), ("charcoal", 4)], outputs: [("molten_copper", 20)], time: 10.0, min_temp: Some(1100)),
    Recipe(id: "copper_smelting_washed", name: Some("Molten copper (washed ore)"), category: "crucible_smelting", inputs: [("washed_malachite", 16), ("charcoal", 4)], outputs: [("molten_copper", 24)], time: 10.0, min_temp: Some(1100)),
    Recipe(id: "bronze_gear", category: "hand", inputs: [("bronze_plate", 2)], outputs: [("bronze_gear", 1)], time: 2.0),
    Recipe(id: "bronze_kit", category: "hand", inputs: [("bronze_gear", 1), ("tin_plate", 1), ("raw_clay_brick", 1)], outputs: [("bronze_kit", 2)], time: 5.0),
    // Bronze: melt 3 copper plates and 1 tin plate together in the crucible (64 units: 4 plates).
    Recipe(id: "bronze_alloy", name: Some("Molten bronze"), category: "alloying", inputs: [("copper_plate", 3), ("tin_plate", 1)], outputs: [("molten_bronze", 64)], time: 4.0, min_temp: Some(1000)),
    Recipe(id: "bronze_plate", category: "casting_plate", inputs: [("molten_bronze", 16)], outputs: [("bronze_plate", 1)], time: 8.0),

