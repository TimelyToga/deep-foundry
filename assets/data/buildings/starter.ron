// Tier 0-1 buildings. See docs/design/02-content.md sections 5.1 and 5.2.
[
    // --- Tier 0: Hand and Fire ---
    Building(
        id: "workbench",
        name: "Workbench",
        description: "Hand crafting is 2 times faster near it.",
        kind: "workbench",
        size: (2, 2),
        tier: 0,
        body: "wood_block",
        crafts: ["hand", "assembling"],
        speed: 2.0,
        params: {"reach": 6.0},
    ),
    Building(
        id: "crucible",
        name: "Crucible",
        description: "Smelts ore with charcoal and makes alloys. Put its left half on a campfire: it takes heat from the cells below it. The tap on its right half pours the molten metal out: put a mold under the tap, one tile away from the fire.",
        kind: "crucible",
        size: (2, 1),
        tier: 0,
        body: "terracotta",
        max_temp: 1600,
        ports: [
            (kind: BulkIn, tile: (0, 0), side: Up),
            (kind: FluidOut, tile: (1, 0), side: Right, name: Some("Tap")),
            (kind: Heat, tile: (0, 0), side: Down),
        ],
        crafts: ["alloying", "crucible_smelting"],
        params: {"capacity": 200.0},
    ),
    Building(
        id: "basic_lab",
        name: "Basic lab",
        description: "Research with bronze kits.",
        kind: "lab",
        size: (2, 2),
        tier: 0,
        body: "wood_block",
        ports: [(kind: PartIn, tile: (0, 0), side: Up)],
        category: Some("research"),
        params: {"kit_buffer": 10.0},
    ),
    Building(
        id: "campfire",
        name: "Campfire",
        description: "Burns wood or charcoal from its fuel slot. It fires raw clay bricks into clay bricks, slowly (pit firing). It heats what is above it.",
        kind: "furnace",
        size: (1, 1),
        tier: 0,
        // A fire pit lined with baked clay: a wood body would catch fire from its own heat port,
        // and stone melts at 1200 °C (the bellows make the fire 1300 °C).
        body: "terracotta",
        max_temp: 1500,
        ports: [
            (kind: BulkIn, tile: (0, 0), side: Up, filter: ["wood", "charcoal", "raw_coal", "coke"]),
            (kind: Heat, tile: (0, 0), side: Up),
        ],
        power: Some((tier: 0, burn_w: 4000.0)),
        category: Some("power"),
        // A crafter with a fuel slot (see foundry_factory machines.rs): the slot holds 100 units
        // of wood or charcoal, and one unit burns for 300 ticks (5 seconds). The buffers hold 8
        // bricks.
        crafts: ["pit_firing"],
        params: {"buffer_crafts": 8.0, "fuel_capacity": 100.0, "fuel_ticks": 300.0, "heat_temp": 1000.0},
    ),
    Building(
        id: "wood_wall",
        name: "Wood block",
        description: "A wall block. It burns at 300 degrees C.",
        kind: "wall",
        size: (1, 1),
        tier: 0,
        body: "wood_block",
        category: Some("logistics"),
        stack: 100,
    ),
    Building(
        id: "clay_brick_wall",
        name: "Clay brick wall",
        description: "A wall block for kiln rooms. It holds up to 1200 degrees C.",
        kind: "room_wall",
        size: (1, 1),
        tier: 0,
        body: "clay_brick_block",
        max_temp: 1200,
        category: Some("logistics"),
        stack: 100,
    ),
    Building(
        id: "kiln_controller",
        name: "Kiln controller",
        description: "Put it in the wall of a closed room of clay brick walls, with a kiln hatch in the wall. The room becomes a kiln. Put fuel in its fuel slot: it burns on the floor of the room and heats it.",
        kind: "room_controller",
        size: (1, 1),
        tier: 0,
        body: "clay_brick_block",
        max_temp: 1200,
        crafts: ["kiln", "glass_melting"],
        // A room controller (see foundry_factory rooms): at most 24 tiles inside. The fuel slot
        // holds 400 units; the fuel burns as cells in the room. Each inside tile adds 8 to the
        // speed: a kiln fires many bricks at once, and a bigger kiln fires more.
        params: {"max_tiles": 24.0, "fuel_capacity": 400.0, "buffer_crafts": 16.0, "speed_per_tile": 8.0},
    ),
    Building(
        id: "kiln_hatch",
        name: "Kiln hatch",
        description: "A hatch in the wall of a kiln. In the roof it takes items in: from a hopper, a belt or a crate on top of it. In the floor it gives the products out, into a crate below it or as cells. In a side wall it does both.",
        kind: "room_port",
        size: (1, 1),
        tier: 0,
        body: "clay_brick_block",
        max_temp: 1200,
    ),
    Building(
        id: "bellows",
        name: "Bellows",
        description: "Placed within 3 tiles of a campfire, it blows air into the fire and makes it 300 °C hotter. In the wall of a kiln, or right next to it, it makes the kiln fire 300 °C hotter: enough for copper and firebrick. Its air pipe is clay brick, so it does not burn.",
        kind: "bellows",
        size: (1, 1),
        tier: 0,
        // The air pipe into the fire (a tuyere) is clay brick: a wood body burns next to a hot kiln.
        body: "clay_brick_block",
        max_temp: 1200,
        category: Some("power"),
    ),
    Building(
        id: "plate_mold",
        name: "Plate mold",
        description: "Molten metal poured on its top becomes a plate when it cools. Keep it away from fire: a hot mold does not cool. A crate on its right side collects the plates.",
        kind: "mold",
        size: (1, 1),
        tier: 0,
        body: "clay_brick_block",
        max_temp: 1600,
        ports: [(kind: FluidIn, tile: (0, 0), side: Up), (kind: PartOut, tile: (0, 0), side: Right)],
        crafts: ["casting_plate"],
    ),
    Building(
        id: "stamp_mill",
        name: "Stamp mill",
        description: "Crushes ore powder at a steady rate. Connect a hopper and a belt to its marked ports.",
        kind: "stamp_mill",
        size: (2, 3),
        tier: 0,
        body: "wood_block",
        ports: [(kind: BulkIn, tile: (0, 0), side: Up), (kind: BulkOut, tile: (1, 2), side: Right)],
        crafts: ["crushing"],
        speed: 0.5,
    ),
    Building(
        id: "sluice",
        name: "Sluice",
        description: "Water flows through it. It washes crushed ore into the product port and carries light tailings out with the used water.",
        kind: "sluice",
        size: (3, 1),
        tier: 0,
        body: "wood_block",
        ports: [
            (kind: BulkIn, tile: (0, 0), side: Left),
            (kind: FluidIn, tile: (0, 0), side: Up),
            (kind: BulkOut, tile: (2, 0), side: Right, filter: ["washed_malachite", "washed_cassiterite", "washed_coal", "washed_magnetite", "washed_hematite", "washed_chalcopyrite", "washed_limestone"]),
            (kind: BulkOut, tile: (2, 0), side: Down, filter: ["silt"]),
            (kind: FluidOut, tile: (2, 0), side: Down),
        ],
        crafts: ["washing"],
    ),
    Building(
        id: "hopper",
        name: "Hopper",
        description: "Collects powder that falls into it and releases it below at a set rate.",
        kind: "hopper",
        size: (1, 1),
        tier: 0,
        body: "wood_block",
        category: Some("logistics"),
        params: {"capacity": 64.0, "rate": 16.0},
    ),
    Building(
        id: "wood_belt",
        name: "Wood belt",
        description: "Moves powder and parts at 8 cells per second. It can burn.",
        kind: "belt",
        size: (1, 1),
        tier: 0,
        body: "wood_block",
        category: Some("logistics"),
        stack: 100,
        params: {"belt_speed": 8.0},
    ),
    Building(
        id: "barrel",
        name: "Barrel",
        description: "Holds 500 units of one liquid.",
        kind: "storage",
        size: (1, 1),
        tier: 0,
        body: "wood_block",
        category: Some("logistics"),
        ports: [(kind: FluidIn, tile: (0, 0), side: Up), (kind: FluidOut, tile: (0, 0), side: Down)],
        params: {"slots": 0.0, "tanks": 1.0, "capacity": 500.0},
    ),
    Building(
        id: "crate",
        name: "Crate",
        description: "Holds 8 slots. A slot holds a stack of parts or 6,000 units of a powder or a solid. Liquids go in a barrel.",
        kind: "storage",
        size: (1, 1),
        tier: 0,
        body: "wood_block",
        category: Some("logistics"),
        ports: [
            (kind: PartIn, tile: (0, 0), side: Up),
            (kind: PartOut, tile: (0, 0), side: Down),
            (kind: BulkIn, tile: (0, 0), side: Left),
        ],
        // Slots for parts or bulk material; "capacity" is the units of material in one slot
        // (one full robot tank, see inventory::PLAYER_TANK_UNITS).
        params: {"slots": 8.0, "capacity": 6000.0},
    ),
    Building(
        id: "hub",
        name: "Hub",
        description: "Your landing pod. Deliver parts and materials to repair it and unlock the next tier.",
        kind: "hub",
        size: (3, 3),
        tier: 0,
        body: "steel_block",
        hit_points: 1000,
        ports: [(kind: PartIn, tile: (1, 2), side: Down), (kind: BulkIn, tile: (0, 2), side: Down)],
        // 16 slots for deliveries. A slot holds a stack of parts or "capacity" units of a material.
        params: {"slots": 16.0, "capacity": 1000.0},
    ),

    // --- Tier 1: Steam ---
    Building(
        id: "small_boiler",
        name: "Small boiler",
        description: "Burns fuel to boil water. Makes 6 steam per second. It explodes if it gets water while it is dry and hot.",
        kind: "boiler",
        size: (2, 2),
        tier: 1,
        body: "bronze_block",
        max_temp: 600,
        ports: [
            (kind: BulkIn, tile: (0, 0), side: Up, filter: ["coal", "coke", "charcoal", "wood"]),
            (kind: Pipe, tile: (0, 1), side: Left, name: Some("Water in")),
            (kind: Pipe, tile: (1, 0), side: Right, name: Some("Steam out")),
        ],
        power: Some((tier: 0, burn_w: 30000.0)),
        category: Some("power"),
    ),
    Building(
        id: "bronze_pipe",
        name: "Bronze pipe",
        description: "A back layer pipe. Up to 600 degrees C. Not gas-tight.",
        kind: "pipe",
        size: (1, 1),
        layer: Back,
        tier: 1,
        body: "bronze_block",
        max_temp: 600,
        ports: [(kind: Pipe, tile: (0, 0), side: Left), (kind: Pipe, tile: (0, 0), side: Right)],
        category: Some("logistics"),
        stack: 100,
    ),
    Building(
        id: "steam_crusher",
        name: "Steam crusher",
        description: "Crushes ore. Uses 2 steam per second.",
        kind: "crafter",
        size: (2, 2),
        tier: 1,
        body: "bronze_block",
        max_temp: 400,
        ports: [
            (kind: BulkIn, tile: (0, 0), side: Up),
            (kind: BulkOut, tile: (1, 1), side: Down),
            (kind: Pipe, tile: (0, 1), side: Left, name: Some("Steam in")),
        ],
        crafts: ["crushing"],
        power: Some((tier: 0, steam_per_s: 2.0)),
    ),
    Building(
        id: "steam_wire_drawer",
        name: "Steam wire drawer",
        description: "Draws a plate into wire.",
        kind: "crafter",
        size: (2, 1),
        tier: 1,
        body: "bronze_block",
        max_temp: 400,
        ports: [
            (kind: PartIn, tile: (0, 0), side: Up),
            (kind: PartOut, tile: (1, 0), side: Down),
            (kind: Pipe, tile: (0, 0), side: Left, name: Some("Steam in")),
        ],
        crafts: ["wire_drawing"],
        power: Some((tier: 0, steam_per_s: 1.5)),
