        tier: 1,
        body: "bronze_block",
        max_temp: 400,
        ports: [
            (kind: BulkIn, tile: (0, 0), side: Up),
            (kind: FluidOut, tile: (1, 1), side: Down),
            (kind: Pipe, tile: (0, 1), side: Left, name: Some("Steam in")),
        ],
        crafts: ["extracting"],
        power: Some((tier: 0, steam_per_s: 2.0)),
    ),
    Building(
        id: "steam_press",
        name: "Steam press",
        description: "Presses rubber into sheets.",
        kind: "crafter",
        size: (2, 2),
        tier: 1,
        body: "bronze_block",
        max_temp: 400,
        ports: [
            (kind: BulkIn, tile: (0, 0), side: Up),
            (kind: PartOut, tile: (1, 1), side: Down),
            (kind: Pipe, tile: (0, 1), side: Left, name: Some("Steam in")),
        ],
        crafts: ["pressing"],
        power: Some((tier: 0, steam_per_s: 2.0)),
    ),
    Building(
        id: "pane_mold",
        name: "Pane mold",
        description: "Molten glass in the mold becomes a glass pane when it cools.",
        kind: "mold",
        size: (1, 1),
        tier: 1,
        body: "clay_brick_block",
        max_temp: 1600,
        ports: [(kind: FluidIn, tile: (0, 0), side: Up), (kind: PartOut, tile: (0, 0), side: Right)],
        crafts: ["casting_pane"],
    ),
    Building(
        id: "vial_mold",
        name: "Vial mold",
        description: "Molten glass in the mold becomes a glass vial when it cools.",
        kind: "mold",
        size: (1, 1),
        tier: 1,
        body: "clay_brick_block",
        max_temp: 1600,
        ports: [(kind: FluidIn, tile: (0, 0), side: Up), (kind: PartOut, tile: (0, 0), side: Right)],
        crafts: ["casting_vial"],
    ),
    Building(
        id: "steam_lab",
        name: "Steam lab",
        description: "Researches with bronze kits and steam kits.",
        kind: "lab",
        size: (2, 2),
        tier: 1,
        body: "bronze_block",
        ports: [
            (kind: PartIn, tile: (0, 0), side: Up),
            (kind: Pipe, tile: (1, 0), side: Right, name: Some("Steam in")),
        ],
        category: Some("research"),
        power: Some((tier: 0, steam_per_s: 1.0)),
        params: {"kit_buffer": 10.0},
    ),
    Building(
        id: "iron_belt",
        name: "Iron belt",
        description: "Moves powder and parts at 16 cells per second.",
        kind: "belt",
        size: (1, 1),
        tier: 1,
        body: "pig_iron_block",
        category: Some("logistics"),
        stack: 100,
        params: {"belt_speed": 16.0},
    ),
    // --- Tier 1 automation ---
    Building(
        id: "arm",
        name: "Arm",
        description: "Moves items from the building on its left to the building on its right (turn it to change the direction). It takes products out of machines, stacks out of crates and powder out of hoppers, and puts them into machines, crates, hoppers, labs, boilers and the Hub. It takes only what the other building has room for.",
        kind: "arm",
        size: (1, 1),
        tier: 1,
        body: "bronze_block",
        // Only arrows for the ghost and the window: the arm moves items itself (see arms.rs).
        ports: [(kind: PartIn, tile: (0, 0), side: Left), (kind: PartOut, tile: (0, 0), side: Right)],
        category: Some("logistics"),
        stack: 50,
        params: {"period": 20.0},
    ),
    Building(
        id: "steam_assembler",
        name: "Steam assembler",
        description: "Makes parts from parts: bronze gears, pipe sections and research kits. Arms or crates bring the parts in, and arms take the products out. Uses 2 steam per second.",
        kind: "crafter",
        size: (2, 2),
        tier: 1,
        body: "bronze_block",
        max_temp: 400,
        ports: [
            (kind: PartIn, tile: (0, 1), side: Left),
            (kind: PartOut, tile: (1, 1), side: Right),
            (kind: Pipe, tile: (0, 0), side: Left, name: Some("Steam in")),
        ],
        crafts: ["assembling"],
        power: Some((tier: 0, steam_per_s: 2.0)),
        params: {"buffer_crafts": 4.0},
    ),
    Building(
        id: "steam_furnace",
        name: "Steam furnace",
        description: "Smelts ore with charcoal or coke, melts copper and tin plates into bronze, and melts sand and ash into glass, with no fire: steam heats it to 1300 °C. Feed it from hoppers or belts on its top (two inputs: put one hopper for ore and one for charcoal), or with arms. Its tap pours into a mold right of it. Uses 3 steam per second.",
        kind: "crafter",
        size: (2, 2),
        tier: 1,
        body: "bronze_block",
        max_temp: 400,
        ports: [
            (kind: BulkIn, tile: (0, 0), side: Up),
            (kind: BulkIn, tile: (1, 0), side: Up),
            (kind: FluidOut, tile: (1, 0), side: Right, name: Some("Tap")),
            (kind: Pipe, tile: (0, 1), side: Left, name: Some("Steam in")),
        ],
        crafts: ["crucible_smelting", "alloying", "glass_melting", "curing"],
        power: Some((tier: 0, steam_per_s: 3.0)),
        // With steam the furnace counts as this hot for the min_temp of its recipes.
        params: {"internal_heat": 1300.0, "buffer_crafts": 4.0},
    ),
    Building(
        id: "steam_drill",
        name: "Steam drill",
        description: "Mines the ground under it, down to 6 tiles deep and as wide as the drill. Useful material (ore, coal, clay, sand) comes out of its port on the right, waste (dirt, stone) out of its port on the left: into a crate, a hopper, a belt or the ground. It digs stone and iron ore. Uses 3 steam per second.",
        kind: "drill",
        size: (2, 2),
        tier: 1,
        body: "bronze_block",
        max_temp: 400,
        ports: [
            (kind: BulkOut, tile: (1, 1), side: Right, name: Some("Ore")),
            (kind: BulkOut, tile: (0, 1), side: Left, name: Some("Waste")),
            (kind: Pipe, tile: (0, 0), side: Left, name: Some("Steam in")),
        ],
        power: Some((tier: 0, steam_per_s: 3.0)),
        // Buffer cells, cells per second out, ticks per dug cell, depth in tiles, hardest material.
        params: {"capacity": 64.0, "rate": 16.0, "dig_period": 6.0, "depth": 6.0, "hardness": 60.0},
    ),
    Building(
        id: "iron_crate",
        name: "Iron crate",
        description: "Holds 16 slots. A slot holds a stack of parts or 6,000 units of a powder. It does not burn.",
        kind: "storage",
        size: (1, 1),
        tier: 1,
        body: "steel_block",
        max_temp: 1200,
        category: Some("logistics"),
        ports: [
            (kind: PartIn, tile: (0, 0), side: Up),
            (kind: PartOut, tile: (0, 0), side: Down),
            (kind: BulkIn, tile: (0, 0), side: Left),
        ],
        params: {"slots": 16.0, "capacity": 6000.0},
    ),
    Building(
        id: "firebrick_wall",
        name: "Firebrick wall",
        description: "A wall block for hot rooms. It holds up to 1800 degrees C.",
        kind: "room_wall",
        size: (1, 1),
        tier: 1,
        body: "firebrick_block",
        max_temp: 1800,
        category: Some("logistics"),
        stack: 100,
    ),
    Building(
        id: "coke_oven_controller",
        name: "Coke oven controller",
        description: "Put it in the wall of a closed room of firebrick walls, with a coke oven hatch in the wall. The room becomes a coke oven. Put fuel in its fuel slot: it burns on the floor of the room and heats it.",
        kind: "room_controller",
        size: (1, 1),
        tier: 1,
        body: "firebrick_block",
        max_temp: 1800,
        crafts: ["coke_oven"],
        params: {"max_tiles": 32.0, "fuel_capacity": 400.0, "buffer_crafts": 4.0, "speed_per_tile": 2.0},
    ),
    Building(
        id: "coke_oven_hatch",
        name: "Coke oven hatch",
        description: "A hatch in the wall of a coke oven. In the roof it takes coal in and lets the coal gas out. In the floor or a side wall it gives the coke and the creosote out.",
        kind: "room_port",
        size: (1, 1),
        tier: 1,
        body: "firebrick_block",
        max_temp: 1800,
    ),
    Building(
        id: "steam_blower",
        name: "Steam blower",
        description: "A firebrick wall block that blows air into the fire of its room: the room gets 300 °C hotter. Put it in the wall of a blast furnace or a kiln. Uses 1 steam per second.",
        kind: "bellows",
        size: (1, 1),
        tier: 1,
        body: "firebrick_block",
        max_temp: 1800,
        ports: [(kind: Pipe, tile: (0, 0), side: Left, name: Some("Steam in"))],
        power: Some((tier: 0, steam_per_s: 1.0)),
        category: Some("power"),
    ),
    Building(
        id: "blast_furnace_controller",
        name: "Blast furnace controller",
        description: "Put it in the wall of a closed room of firebrick walls, with blast furnace hatches in the wall. The room becomes a blast furnace. Burn coke in it; pig iron needs 1400 degrees C, so it also needs hot air from bellows or a blower.",
        kind: "room_controller",
        size: (1, 1),
        tier: 1,
        body: "firebrick_block",
        max_temp: 1800,
        crafts: ["blast_furnace"],
        params: {"max_tiles": 48.0, "fuel_capacity": 800.0, "buffer_crafts": 4.0},
    ),
    Building(
        id: "blast_furnace_hatch",
        name: "Blast furnace hatch",
        description: "A hatch in the wall of a blast furnace. In the roof it takes ore, coke and limestone in. In a side wall or the floor it is a tap: the lowest tap gives the molten iron, the next one up the slag.",
        kind: "room_port",
        size: (1, 1),
        tier: 1,
        body: "firebrick_block",
        max_temp: 1800,
    ),
    Building(
        id: "steel_converter",
        name: "Steel converter",
        description: "Blows air through molten pig iron. Makes steel, slag and carbon dioxide.",
        kind: "crafter",
        size: (2, 3),
        tier: 1,
        body: "firebrick_block",
        max_temp: 1800,
        ports: [
            (kind: FluidIn, tile: (0, 0), side: Up, name: Some("Pig iron in")),
            (kind: FluidOut, tile: (1, 2), side: Down, name: Some("Steel tap")),
            (kind: BulkOut, tile: (1, 1), side: Right, name: Some("Slag"), filter: ["crushed_slag"]),
            (kind: Exhaust, tile: (1, 0), side: Up),
            (kind: Pipe, tile: (0, 1), side: Left, name: Some("Steam in")),
        ],
        crafts: ["steel_converting"],
        power: Some((tier: 0, steam_per_s: 3.0)),
        // The air that the steam blows through the molten iron burns its carbon: that keeps it
        // hot (°C) while it gets steam.
        params: {"internal_heat": 1600.0},
    ),

    // --- Tier 2: LV electric power ---
    Building(
        id: "steam_turbine",
        name: "Steam turbine",
        description: "Turns steam into electric power: up to 12 kW from 6 steam per second. Put a copper cable behind its power port; machines on the same cable network share the power.",
        kind: "generator",
        size: (2, 2),
        tier: 2,
        body: "steel_block",
        max_temp: 600,
        ports: [
            (kind: Pipe, tile: (0, 1), side: Left, name: Some("Steam in")),
            (kind: Power, tile: (1, 1), side: Right),
        ],
        power: Some((tier: 1, produce_w: 12000.0, steam_per_s: 6.0)),
        category: Some("power"),
    ),
    Building(
        id: "copper_cable",
        name: "Copper cable",
        description: "A back layer cable. Cables on tiles next to each other are one power network. A machine joins the network when a cable is behind its power port.",
        kind: "cable",
        size: (1, 1),
        layer: Back,
        tier: 2,
        body: "copper_block",
        category: Some("power"),
        stack: 200,
    ),
    Building(
        id: "macerator",
        name: "Macerator",
        description: "An electric crusher. It crushes ore 4 times faster than the stamp mill. Feed it from a hopper on top; the crushed ore comes out below.",
        kind: "crafter",
        size: (2, 2),
        tier: 2,
        body: "steel_block",
