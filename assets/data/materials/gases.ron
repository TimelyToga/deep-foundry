// More gases. Steam and smoke are in basic.ron.
// Air has density 1.2. Lighter gases rise, heavier gases sink.
// See docs/design/02-content.md section 2.6.
[
    Material(
        id: "methane",
        name: "Methane",
        phase: Gas,
        colors: ["#c9e0c070", "#d3e8ca70", "#bdd8b460"],
        density: 0.7,
        heat_capacity: 0.53,
        conductivity: 0.03,
        tags: ["flammable"],
        note: Some("Explodes on contact with fire or a spark. See reactions/burning.ron."),
    ),
    Material(
        id: "coal_gas",
        name: "Coal gas",
        phase: Gas,
        colors: ["#cfcfae70", "#d8d8b670", "#c3c3a460"],
        density: 0.6,
        heat_capacity: 0.5,
        conductivity: 0.03,
        tags: ["flammable", "fuel"],
    ),
    Material(
        id: "hydrogen",
        name: "Hydrogen",
        phase: Gas,
        colors: ["#e4f0ff50", "#eef6ff50", "#dbe9fb40"],
        density: 0.09,
        heat_capacity: 3.4,
        conductivity: 0.05,
        tags: ["flammable"],
    ),
    Material(
        id: "oxygen",
        name: "Oxygen",
        phase: Gas,
        colors: ["#dfefff60", "#e8f5ff60", "#d3e8fb50"],
        density: 1.43,
        heat_capacity: 0.22,
        conductivity: 0.03,
        note: Some("Makes fire burn hotter. See reactions/burning.ron."),
    ),
    Material(
        id: "nitrogen",
        name: "Nitrogen",
        phase: Gas,
        colors: ["#e6e6ea50", "#eeeef250", "#dcdce140"],
        density: 1.25,
        heat_capacity: 0.25,
        conductivity: 0.03,
        note: Some("Does not react."),
    ),
    Material(
        id: "carbon_dioxide",
        name: "Carbon dioxide",
        phase: Gas,
        colors: ["#c8c8ce70", "#d0d0d670", "#bcbcc260"],
        density: 1.98,
        heat_capacity: 0.2,
        conductivity: 0.02,
        tags: ["fire_out"],
        note: Some("Sinks and collects in low tunnels. Puts out fire."),
    ),
    Material(
        id: "chlorine",
        name: "Chlorine",
        phase: Gas,
        colors: ["#c8e070a0", "#d3ea7ca0", "#bcd46590"],
        density: 3.2,
        heat_capacity: 0.13,
        conductivity: 0.03,
        tags: ["toxic", "corrosive"],
    ),
    Material(
        id: "sulfur_dioxide",
        name: "Sulfur dioxide",
        phase: Gas,
        colors: ["#d8d090a0", "#e2da9ca0", "#ccc48590"],
        density: 2.6,
        heat_capacity: 0.15,
        conductivity: 0.03,
        tags: ["toxic", "corrosive"],
        note: Some("With water: acid water. Causes acid rain."),
    ),
    Material(
        id: "hydrogen_sulfide",
        name: "Hydrogen sulfide",
        phase: Gas,
        colors: ["#d8c89090", "#e2d29c90", "#ccbc8580"],
        density: 1.36,
        heat_capacity: 0.24,
        conductivity: 0.03,
        burn: Some((ignite_at: 260, fire_temp: 900, chance: 0.05, into: Some("air"), smoke: Some("sulfur_dioxide"), smoke_chance: 1.0)),
        tags: ["toxic", "flammable"],
    ),
    Material(
        id: "zinc_vapor",
        name: "Zinc vapor",
        phase: Gas,
        colors: ["#e8eaea90", "#f0f2f290", "#dcdedf80"],
        density: 3.0,
        heat_capacity: 0.12,
        conductivity: 0.05,
        condense: Some((at: 907, into: "molten_zinc")),
        tags: ["toxic"],
    ),
]
