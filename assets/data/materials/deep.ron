// Materials of the caves and the deep rock: light in the dark, crystals and gold.
// See crates/worldgen/src/deep.rs for where they are.
[
    Material(
        id: "glow_moss",
        name: "Glow moss",
        note: Some("A moss that grows on the floors and ceilings of deep caves and gives a soft light. Dig it to make lanterns."),
        phase: Solid,
        colors: ["#3fe0b0", "#2fc79a", "#5ef0c4", "#28a985"],
        density: 300,
        hardness: 3,
        heat_capacity: 0.5,
        conductivity: 0.05,
        glow: 0.55,
        burn: Some((ignite_at: 250, fire_temp: 500, chance: 0.05, into: Some("ash"), smoke: Some("smoke"), smoke_chance: 0.1)),
        tags: ["organic"],
    ),
    Material(
        id: "glow_crystal",
        name: "Glow crystal",
        note: Some("A crystal that gives light. It lines geodes in the deep rock. It breaks into crystal shards."),
        phase: Solid,
        colors: ["#9a6bff", "#7fd4ff", "#b48aff", "#6ac0ff"],
        density: 2600,
        hardness: 50,
        heat_capacity: 0.8,
        conductivity: 0.3,
        glow: 0.85,
        broken_into: Some("crystal_shards"),
        tags: ["mineral"],
    ),
    Material(
        id: "crystal_shards",
        name: "Crystal shards",
        note: Some("Broken glow crystal. It still gives light. Crystal lamps are made of it."),
        phase: Powder,
        colors: ["#9a6bff", "#7fd4ff", "#b48aff"],
        density: 2600,
        friction: 0.4,
        grain: Medium,
        heat_capacity: 0.8,
        conductivity: 0.3,
        glow: 0.45,
        tags: ["mineral"],
    ),
    Material(
        id: "native_gold",
        name: "Native gold",
        note: Some("Gold in the deep rock, in small rich deposits and in the walls of deep caves."),
        phase: Solid,
        colors: ["#5a4a2a", "#d9b23a", "#4b3f2a", "#f2cf55"],
        density: 6000,
        hardness: 40,
        heat_capacity: 0.3,
        conductivity: 0.8,
        glow: 0.12,
        broken_into: Some("raw_gold"),
        tags: ["ore"],
    ),
    Material(
        id: "raw_gold",
        name: "Raw gold",
        phase: Powder,
        colors: ["#8a7333", "#c9a43e", "#6e5c2c"],
        density: 6000,
        friction: 0.35,
        grain: Medium,
        heat_capacity: 0.3,
        conductivity: 0.8,
        tags: ["ore"],
    ),
    Material(
        id: "moss_lantern_block",
        name: "Moss lantern",
        note: Some("The body of a moss lantern: glow moss in a wood frame. It gives light."),
        phase: Solid,
        colors: ["#7af0c8", "#5fd9b0", "#6b4a2a", "#86f7d2"],
        density: 600,
        hardness: 10,
        heat_capacity: 0.6,
        conductivity: 0.1,
        glow: 0.75,
        tags: ["building"],
    ),
]
