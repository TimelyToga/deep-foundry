// Processed powders: fuels, metal dusts and mineral powders.
// See docs/design/02-content.md section 2.3.
[
    Material(
        id: "charcoal",
        name: "Charcoal",
        phase: Powder,
        colors: ["#2a2420", "#332c26", "#221d19"],
        density: 400,
        friction: 0.25,
        grain: Medium,
        heat_capacity: 0.5,
        conductivity: 0.1,
        burn: Some((ignite_at: 350, fire_temp: 1100, chance: 0.0025, into: Some("ash"), smoke: Some("smoke"), smoke_chance: 0.02, gases: [("carbon_dioxide", 0.05)])),
        tags: ["fuel", "carbon", "flammable"],
    ),
    Material(
        id: "coke",
        name: "Coke",
        phase: Powder,
        colors: ["#232323", "#2b2b2b", "#1b1b1b"],
        density: 600,
