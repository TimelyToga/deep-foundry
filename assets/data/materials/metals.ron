// Molten metals and their solid block forms. Freezing is 10 C below melting.
// See docs/design/02-content.md section 2.5 and section 2.8 (metal block).
[
    // --- Tin ---
    Material(
        id: "molten_tin",
        name: "Molten tin",
        phase: Liquid,
        colors: ["#ffd9a0d0", "#ffe2b3d0", "#f5cd8dd0"],
        density: 7000,
        flow: 3,
        momentum: 0.55,
        splash: 0.12,
        heat_capacity: 0.13,
        conductivity: 0.7,
        temperature: Some(282),
        freeze: Some((at: 222, into: "tin_block")),
        glow: 0.5,
        tags: ["metal", "molten", "conductive"],
    ),
    Material(
        id: "tin_block",
        name: "Tin block",
        phase: Solid,
        colors: ["#c9cdd1", "#d3d7db", "#bec2c6"],
        density: 7300,
        hardness: 25,
        heat_capacity: 0.13,
        conductivity: 0.7,
        melt: Some((at: 232, into: "molten_tin")),
        tags: ["metal", "conductive"],
    ),

    // --- Lead ---
    Material(
        id: "molten_lead",
        name: "Molten lead",
        phase: Liquid,
        colors: ["#c9a06fd0", "#d6ac7ad0", "#bd9564d0"],
        density: 10600,
        flow: 3,
        momentum: 0.55,
        splash: 0.12,
        heat_capacity: 0.03,
        conductivity: 0.65,
        temperature: Some(377),
        freeze: Some((at: 317, into: "lead_block")),
        glow: 0.5,
        tags: ["metal", "molten", "toxic"],
    ),
    Material(
        id: "lead_block",
        name: "Lead block",
        phase: Solid,
        colors: ["#767a80", "#7f838a", "#6d7176"],
        density: 11000,
        hardness: 20,
        heat_capacity: 0.03,
        conductivity: 0.65,
        melt: Some((at: 327, into: "molten_lead")),
        tags: ["metal", "toxic"],
        note: Some("Radiation shield."),
    ),

