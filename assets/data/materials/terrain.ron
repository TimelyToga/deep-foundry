// More terrain and rock for the surface and the upper stone layers.
// The basic terrain ids (air, bedrock, stone, sand, gravel, dirt, wood, ash) are in basic.ron.
// See docs/design/02-content.md section 2.1.
[
    Material(
        id: "grass",
        name: "Grass",
        phase: Solid,
        colors: ["#4a7a2e", "#548636", "#3f6d27", "#5c9440"],
        density: 1300,
        hardness: 8,
        heat_capacity: 0.7,
        conductivity: 0.1,
        broken_into: Some("dirt"),
        burn: Some((ignite_at: 250, fire_temp: 600, chance: 0.03, into: Some("dirt"), smoke: Some("smoke"), smoke_chance: 0.1)),
        tags: ["flammable", "organic"],
        note: Some("Spreading onto nearby dirt in light needs a coded behavior. See requests/content-data.md."),
    ),
    Material(
