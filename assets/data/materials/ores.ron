// Tier 0-1 ore veins and their raw, crushed and washed powders.
// An ore vein is a solid. Digging it makes the raw ore powder (broken_into).
// A crusher turns raw ore into crushed ore. A sluice or washer turns crushed ore into washed ore.
// See docs/design/02-content.md sections 2.2 and 2.3.
[
    // --- Malachite (copper ore) ---
    Material(
        id: "malachite",
        name: "Malachite",
        phase: Solid,
        colors: ["#1f6b4a", "#278060", "#175539", "#2f9070"],
        density: 4000,
        hardness: 15,
        heat_capacity: 0.7,
        conductivity: 0.2,
        broken_into: Some("raw_malachite"),
        tags: ["ore"],
    ),
    Material(
        id: "raw_malachite",
        name: "Raw malachite",
        phase: Powder,
        colors: ["#1f6b4a", "#278060", "#175539"],
        density: 4000,
        friction: 0.35,
        grain: Medium,
        heat_capacity: 0.7,
        conductivity: 0.2,
        tags: ["ore"],
    ),
    Material(
        id: "crushed_malachite",
        name: "Crushed malachite",
        phase: Powder,
        colors: ["#256f4d", "#2c8563", "#1c5c3e"],
        density: 4000,
        friction: 0.3,
        grain: Small,
        heat_capacity: 0.7,
        conductivity: 0.2,
        tags: ["ore"],
    ),
    Material(
        id: "washed_malachite",
        name: "Washed malachite",
        phase: Powder,
        colors: ["#2a7754", "#31896a", "#215f41"],
        density: 4000,
        friction: 0.25,
        grain: Small,
        heat_capacity: 0.7,
        conductivity: 0.2,
        tags: ["ore"],
    ),

