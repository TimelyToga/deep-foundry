        colors: ["#8a5a3ad0", "#9a6844d0", "#7a4e30d0"],
        density: 2800,
        flow: 2,
        momentum: 0.3,
        splash: 0.05,
        heat_capacity: 0.45,
        conductivity: 0.25,
        temperature: Some(1250),
        freeze: Some((at: 1190, into: "slag_block")),
