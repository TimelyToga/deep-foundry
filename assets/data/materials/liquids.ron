        flow: 3,
        momentum: 0.5,
        splash: 0.08,
        heat_capacity: 0.45,
        conductivity: 0.1,
        temperature: Some(150),
        freeze: Some((at: 105, into: "sulfur_dust")),
        burn: Some((ignite_at: 230, fire_temp: 900, chance: 0.05, into: Some("air"), smoke: Some("sulfur_dioxide"), smoke_chance: 1.0)),
