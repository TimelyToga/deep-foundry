    ),
    Material(
        id: "wet_concrete",
        name: "Wet concrete",
        phase: Liquid,
        colors: ["#8f8d88c8", "#98968fc8", "#858380c8"],
        density: 2400,
        flow: 1,
        momentum: 0.1,
        splash: 0.0,
        heat_capacity: 0.7,
        conductivity: 0.2,
        note: Some("Sets into concrete after about 30 seconds. `life` is a u8 (max about 4 seconds at 60 ticks/s), so this timing is a reaction in reactions/minerals.ron instead. See requests/content-data.md."),
    ),
    Material(
        id: "molten_glass",
        name: "Molten glass",
        phase: Liquid,
        colors: ["#ff9a3cd0", "#ffab55d0", "#f08a2cd0"],
