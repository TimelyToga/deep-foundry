// More liquids. Water, crude oil ("oil") and lava are in basic.ron.
// See docs/design/02-content.md section 2.4.
[
    Material(
        id: "brine",
        name: "Brine",
        phase: Liquid,
        colors: ["#3a78c9c8", "#3670bec8", "#4080d4c8"],
        density: 1200,
        flow: 8,
        momentum: 0.9,
        splash: 0.3,
        heat_capacity: 0.95,
        conductivity: 0.32,
        boil: Some((at: 105, into: "steam")),
        freeze: Some((at: -20, into: "ice")),
        drag_limit: 1700,
        tags: ["conductive", "soluble"],
        note: Some("Salt water. Some salt is left behind when it boils away; the schema can only pick one result, so we keep it simple and boil fully to steam."),
    ),
    Material(
        id: "dirty_water",
        name: "Dirty water",
        phase: Liquid,
        colors: ["#4a4a3ac8", "#52523fc8", "#42422fc8"],
        density: 1050,
        flow: 8,
        momentum: 0.88,
        splash: 0.3,
        heat_capacity: 0.95,
        conductivity: 0.25,
        drag_limit: 1200,
        note: Some("Washer waste. Carries small dust. The centrifuge removes the dust."),
    ),
    Material(
        id: "mud",
        name: "Mud",
        phase: Liquid,
        colors: ["#4a3722c8", "#523d27c8", "#40301dc8"],
        density: 1600,
        flow: 1,
        momentum: 0.0,
        splash: 0.0,
        heat_capacity: 0.8,
        conductivity: 0.15,
        melt: Some((at: 60, into: "dirt")),
        note: Some("Dries slowly in open air even below 60 C. That needs a time-in-air rule the schema does not have yet."),
    ),
    Material(
        id: "heavy_oil",
        name: "Heavy oil",
        phase: Liquid,
        colors: ["#1c150fc8", "#221a13c8", "#17110cc8"],
        density: 950,
        flow: 3,
        momentum: 0.5,
        splash: 0.05,
        heat_capacity: 0.5,
        conductivity: 0.1,
        burn: Some((ignite_at: 300, fire_temp: 850, chance: 0.008, smoke: Some("smoke"), smoke_chance: 0.25)),
        tags: ["flammable", "oil", "fuel"],
    ),
    Material(
        id: "creosote",
        name: "Creosote",
        phase: Liquid,
        colors: ["#241b12c8", "#2b2116c8", "#1e160fc8"],
        density: 1080,
        flow: 4,
        momentum: 0.6,
        splash: 0.1,
        heat_capacity: 0.5,
        conductivity: 0.1,
        burn: Some((ignite_at: 400, fire_temp: 850, chance: 0.008, smoke: Some("smoke"), smoke_chance: 0.2)),
        tags: ["flammable", "oil", "fuel"],
    ),
    Material(
        id: "tar",
        name: "Tar",
        phase: Liquid,
        colors: ["#0f0d0cc8", "#141110c8", "#0a0908c8"],
        density: 1200,
        flow: 1,
        momentum: 0.0,
        splash: 0.0,
        heat_capacity: 0.55,
        conductivity: 0.08,
        burn: Some((ignite_at: 400, fire_temp: 700, chance: 0.006, smoke: Some("smoke"), smoke_chance: 0.3)),
        tags: ["flammable", "oil"],
    ),
    Material(
        id: "resin",
        name: "Resin",
        phase: Liquid,
        colors: ["#c98a2ec8", "#d6952fc8", "#bb7f28c8"],
        density: 1100,
        flow: 2,
        momentum: 0.2,
        splash: 0.0,
        heat_capacity: 0.6,
        conductivity: 0.08,
        melt: Some((at: 150, into: "rubber")),
        tags: ["organic"],
    ),
    Material(
        id: "sulfuric_acid",
        name: "Sulfuric acid",
        phase: Liquid,
        colors: ["#c7c22fc8", "#d1cc37c8", "#bcb728c8"],
