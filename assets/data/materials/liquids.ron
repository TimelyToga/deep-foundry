        tags: ["molten"],
        note: Some("Floats on molten iron because it is lighter."),
    ),
    Material(
        id: "molten_salt",
        name: "Molten salt",
        phase: Liquid,
        colors: ["#ffd27ad0", "#ffdd8fd0", "#f2c368d0"],
        density: 1550,
        flow: 4,
        momentum: 0.6,
        splash: 0.1,
        heat_capacity: 0.5,
        conductivity: 0.4,
        temperature: Some(850),
        freeze: Some((at: 791, into: "salt")),
        glow: 0.2,
        tags: ["molten", "conductive"],
