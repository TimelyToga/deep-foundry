// Building blocks: the solid materials walls and building bodies are made of.
// See docs/design/02-content.md section 2.8.
[
    Material(
        id: "wood_block",
        name: "Wood block",
        phase: Solid,
        colors: ["#8a5f38", "#946641", "#7e5630"],
        density: 600,
        hardness: 12,
        heat_capacity: 0.6,
        conductivity: 0.08,
        burn: Some((ignite_at: 300, fire_temp: 800, chance: 0.005, into: Some("ash"), smoke: Some("smoke"), smoke_chance: 0.05)),
        tags: ["flammable", "organic"],
    ),
    Material(
        id: "treated_wood",
        name: "Treated wood",
        phase: Solid,
        colors: ["#5a4028", "#634630", "#513a22"],
        density: 650,
        hardness: 14,
        heat_capacity: 0.6,
        conductivity: 0.08,
        burn: Some((ignite_at: 600, fire_temp: 850, chance: 0.004, into: Some("ash"), smoke: Some("smoke"), smoke_chance: 0.05)),
        tags: ["flammable", "organic"],
        note: Some("Wood plus creosote. Resists fire better than plain wood."),
    ),
    Material(
        id: "clay_brick",
        name: "Clay brick",
        phase: Solid,
        colors: ["#9c5a3c", "#a86545", "#8f5034"],
        density: 1900,
        hardness: 50,
        heat_capacity: 0.85,
        conductivity: 0.25,
        tags: ["heat_proof"],
        note: Some("Fired from a raw clay brick at 900 C, 20 seconds in a kiln (a build recipe, not a reaction)."),
    ),
    Material(
        id: "terracotta",
        name: "Terracotta",
        phase: Solid,
        colors: ["#a8623f", "#b46d49", "#9a5636"],
        density: 1900,
        hardness: 45,
        heat_capacity: 0.85,
        conductivity: 0.25,
    ),
    Material(
        id: "firebrick",
        name: "Firebrick",
        phase: Solid,
        colors: ["#c9b89a", "#d3c3a6", "#bcab8c"],
        density: 2000,
        hardness: 55,
        heat_capacity: 0.9,
        conductivity: 0.05,
        tags: ["heat_proof"],
        note: Some("Low heat conduction. Furnace walls."),
    ),
    Material(
        id: "glass",
        name: "Glass",
        phase: Solid,
        colors: ["#cfe8ecb0", "#dcf1f4b0", "#c1dde2a0"],
        density: 2500,
        hardness: 40,
        heat_capacity: 0.5,
        conductivity: 0.05,
        melt: Some((at: 1000, into: "molten_glass")),
        tags: ["acid_proof"],
        note: Some("Transparent. Does not conduct."),
    ),
    Material(
        id: "concrete",
        name: "Concrete",
        phase: Solid,
        colors: ["#8f8d88", "#98968f", "#847f7a"],
        density: 2400,
        hardness: 65,
        heat_capacity: 0.7,
        conductivity: 0.2,
    ),
    Material(
        id: "slag_block",
        name: "Slag block",
        phase: Solid,
        colors: ["#6a4a34", "#75533b", "#5f412d"],
        density: 2800,
        hardness: 40,
        heat_capacity: 0.45,
        conductivity: 0.25,
        melt: Some((at: 1200, into: "molten_slag")),
    ),
    Material(
        id: "rubber",
        name: "Rubber",
        phase: Solid,
        colors: ["#2a2622", "#302c27", "#231f1c"],
        density: 1100,
        hardness: 15,
        heat_capacity: 0.6,
        conductivity: 0.02,
        burn: Some((ignite_at: 300, fire_temp: 700, chance: 0.01, into: Some("ash"), smoke: Some("smoke"), smoke_chance: 0.3)),
        tags: ["flammable", "organic"],
        note: Some("Electric insulator."),
    ),
]
