// Extra buildings for the UI mock and the UI screenshots (Tier 0 to Tier 2, from docs/design/02-content.md).
// The mock adds an entry only if assets/data does not have the id yet. These are not game data.
[
    // Tier 0: Hand and Fire
    Building(id: "campfire", name: "Campfire", description: "Burns fuel from its small hopper. Heats what is above it.", kind: "furnace", size: (1, 1), tier: 0, body: "wood_block", max_temp: 900, category: Some("power"), icon: Some("campfire")),
    Building(id: "wood_wall", name: "Wood block", description: "A wall block. It burns at 300 °C.", kind: "wall", size: (1, 1), tier: 0, body: "wood_block", category: Some("logistics"), stack: 100, icon: Some("block")),
    Building(id: "ladder", name: "Ladder", description: "The robot can climb it.", kind: "wall", size: (1, 1), tier: 0, body: "wood_block", category: Some("logistics"), stack: 100, icon: Some("ladder")),
    Building(id: "clay_brick_wall", name: "Clay brick wall", description: "A wall block for kiln rooms. It holds up to 1200 °C.", kind: "room_wall", size: (1, 1), tier: 0, body: "clay_brick", max_temp: 1200, category: Some("logistics"), stack: 100),
    Building(id: "kiln_controller", name: "Kiln controller", description: "Put it in the wall of a closed clay brick room. The room becomes a kiln.", kind: "room_controller", size: (1, 1), tier: 0, body: "clay_brick", max_temp: 1200, crafts: ["kiln"]),
    Building(id: "kiln_hatch", name: "Kiln hatch", description: "An input for a kiln room.", kind: "room_port", size: (1, 1), tier: 0, body: "clay_brick", max_temp: 1200),
    Building(id: "bellows", name: "Bellows", description: "Water turns its wheel. It makes the fire in its room up to 300 °C hotter.", kind: "bellows", size: (1, 1), tier: 0, body: "wood_block", category: Some("power")),
    Building(id: "ingot_mold", name: "Ingot mold", description: "Molten metal in the mold becomes an ingot when it cools.", kind: "mold", size: (1, 1), tier: 0, body: "terracotta", max_temp: 1200, crafts: ["casting"]),
    Building(id: "plate_mold", name: "Plate mold", description: "Molten metal in the mold becomes a plate when it cools.", kind: "mold", size: (1, 1), tier: 0, body: "clay_brick", max_temp: 1200, crafts: ["casting_plate"]),
    Building(id: "stamp_mill", name: "Stamp mill", description: "A crusher that water drives. Water must flow through its wheel.", kind: "stamp_mill", size: (2, 3), tier: 0, body: "wood_block", crafts: ["crushing"], speed: 0.5),
    Building(id: "sluice", name: "Sluice", description: "Water flows through it. Heavy powder stays. Light powder washes out.", kind: "sluice", size: (3, 1), tier: 0, body: "wood_block", crafts: ["washing"]),
    Building(id: "hopper", name: "Hopper", description: "Collects powder and releases it at a set rate. It can filter.", kind: "hopper", size: (1, 1), tier: 0, body: "wood_block", category: Some("logistics")),
    Building(id: "wood_belt", name: "Wood belt", description: "Moves powder and parts at 8 cells per second. It can burn.", kind: "belt", size: (1, 1), tier: 0, body: "wood_block", category: Some("logistics"), stack: 100, params: {"belt_speed": 8.0}),
    Building(id: "barrel", name: "Barrel", description: "Holds 500 units of liquid.", kind: "storage", size: (1, 1), tier: 0, body: "wood_block", category: Some("logistics"), params: {"capacity": 500.0}),
    Building(id: "crate", name: "Crate", description: "Holds 8 stacks of parts.", kind: "storage", size: (1, 1), tier: 0, body: "wood_block", category: Some("logistics"), params: {"slots": 8.0}),
    // Tier 1: Steam
    Building(id: "small_boiler", name: "Small boiler", description: "Burns fuel to boil water. Makes 6 steam per second. It explodes if it gets water while it is dry and hot.", kind: "boiler", size: (2, 2), tier: 1, body: "bronze_block", max_temp: 600, category: Some("power"), power: Some((tier: 0, burn_w: 30000.0))),
    Building(id: "steam_crusher", name: "Steam crusher", description: "Crushes ore. Uses 2 steam per second.", kind: "crafter", size: (2, 2), tier: 1, body: "bronze_block", max_temp: 400, crafts: ["crushing"], power: Some((tier: 0, steam_per_s: 2.0))),
    Building(id: "steam_hammer", name: "Steam hammer", description: "Hammers ingots into plates.", kind: "crafter", size: (2, 2), tier: 1, body: "bronze_block", max_temp: 400, crafts: ["hammering"], power: Some((tier: 0, steam_per_s: 2.0))),
    Building(id: "steam_wire_drawer", name: "Steam wire drawer", description: "Draws one rod into two wires.", kind: "crafter", size: (2, 1), tier: 1, body: "bronze_block", max_temp: 400, crafts: ["wire_drawing"], power: Some((tier: 0, steam_per_s: 1.5))),
    Building(id: "steam_furnace", name: "Steam furnace", description: "Smelts dust and crushed ore up to 1300 °C.", kind: "furnace", size: (2, 2), tier: 1, body: "bronze_block", max_temp: 1400, crafts: ["smelting"], power: Some((tier: 0, steam_per_s: 3.0))),
    Building(id: "steam_alloy_smelter", name: "Steam alloy smelter", description: "Melts two metals together into an alloy.", kind: "crafter", size: (2, 2), tier: 1, body: "bronze_block", max_temp: 1400, crafts: ["alloying"], power: Some((tier: 0, steam_per_s: 3.0))),
    Building(id: "steam_extractor", name: "Steam extractor", description: "Gets resin out of rubber tree wood.", kind: "crafter", size: (2, 2), tier: 1, body: "bronze_block", max_temp: 400, crafts: ["extracting"], power: Some((tier: 0, steam_per_s: 2.0))),
    Building(id: "steam_press", name: "Steam press", description: "Presses rubber into sheets, and wood chips with resin into circuit boards.", kind: "crafter", size: (2, 2), tier: 1, body: "bronze_block", max_temp: 400, crafts: ["pressing"], power: Some((tier: 0, steam_per_s: 2.0))),
    Building(id: "steam_washer", name: "Steam washer", description: "Washes crushed ore with water. Light waste leaves with dirty water.", kind: "crafter", size: (3, 2), tier: 1, body: "bronze_block", max_temp: 400, crafts: ["washing"], power: Some((tier: 0, steam_per_s: 2.0))),
    Building(id: "steam_assembler", name: "Steam assembler", description: "Makes parts from parts. Uses 4 steam per second.", kind: "crafter", size: (3, 2), tier: 1, body: "bronze_block", max_temp: 400, crafts: ["assembling"], power: Some((tier: 0, steam_per_s: 4.0))),
    Building(id: "steam_pump", name: "Steam pump", description: "Takes fluid from the world into a pipe.", kind: "pump", size: (1, 2), tier: 1, body: "bronze_block", category: Some("logistics"), power: Some((tier: 0, steam_per_s: 1.0))),
    Building(id: "steam_drill", name: "Steam drill", description: "Mines the cells in front of it and puts them out.", kind: "drill", size: (3, 3), tier: 1, body: "steel_block", max_temp: 500, power: Some((tier: 0, steam_per_s: 5.0))),
    Building(id: "steam_lab", name: "Steam lab", description: "Researches with bronze kits and steam kits.", kind: "lab", size: (2, 2), tier: 1, body: "bronze_block", category: Some("research"), power: Some((tier: 0, steam_per_s: 1.0))),
    Building(id: "iron_belt", name: "Iron belt", description: "Moves powder and parts at 16 cells per second.", kind: "belt", size: (1, 1), tier: 1, body: "pig_iron_block", category: Some("logistics"), stack: 100, params: {"belt_speed": 16.0}),
    Building(id: "arm", name: "Arm", description: "Picks up parts in one place and puts them in another place.", kind: "arm", size: (1, 1), tier: 1, body: "pig_iron_block", category: Some("logistics")),
    Building(id: "iron_crate", name: "Iron crate", description: "Holds 16 stacks of parts.", kind: "storage", size: (1, 1), tier: 1, body: "pig_iron_block", category: Some("logistics"), params: {"slots": 16.0}),
    Building(id: "bronze_pipe", name: "Bronze pipe", description: "A back layer pipe. Up to 600 °C. Not gas-tight.", kind: "pipe", size: (1, 1), layer: Back, tier: 1, body: "bronze_block", max_temp: 600, category: Some("logistics"), stack: 100),
    Building(id: "iron_pipe", name: "Iron pipe", description: "A back layer pipe. Up to 800 °C. Gas-tight.", kind: "pipe", size: (1, 1), layer: Back, tier: 1, body: "pig_iron_block", max_temp: 800, category: Some("logistics"), stack: 100),
    Building(id: "tank", name: "Tank", description: "Holds 4000 units of fluid.", kind: "tank", size: (2, 2), tier: 1, body: "pig_iron_block", category: Some("logistics"), params: {"capacity": 4000.0}),
    Building(id: "magnet", name: "Magnet", description: "Pulls magnetic powder to it.", kind: "magnet", size: (1, 1), tier: 1, body: "pig_iron_block", category: Some("logistics")),
    Building(id: "fan", name: "Fan", description: "Pushes gas and light powder.", kind: "fan", size: (1, 1), tier: 1, body: "pig_iron_block", category: Some("logistics")),
    // Tier 2: LV (for the power network window)
    Building(id: "steam_turbine", name: "Steam turbine", description: "Makes electric power from steam.", kind: "generator", size: (3, 2), tier: 2, body: "steel_block", category: Some("power"), power: Some((tier: 1, produce_w: 20000.0))),
    Building(id: "combustion_generator", name: "Combustion generator", description: "Burns fuel to make electric power.", kind: "generator", size: (2, 2), tier: 2, body: "steel_block", category: Some("power"), power: Some((tier: 1, produce_w: 16000.0))),
    Building(id: "solar_panel", name: "Solar panel", description: "Makes power in daylight. Smoke and smog make it weaker.", kind: "generator", size: (2, 1), tier: 2, body: "glass", category: Some("power"), power: Some((tier: 1, produce_w: 2000.0))),
    Building(id: "battery_box", name: "Battery box", description: "Stores electric energy.", kind: "battery", size: (1, 1), tier: 2, body: "lead_block", category: Some("power"), power: Some((tier: 1, store_j: 2000000.0))),
    Building(id: "water_turbine", name: "Water turbine", description: "Makes electric power from flowing water.", kind: "generator", size: (2, 2), tier: 2, body: "steel_block", category: Some("power"), power: Some((tier: 1, produce_w: 4000.0))),
    Building(id: "tin_cable", name: "Tin cable", description: "A bare LV cable. Limit: 32 A. Water makes it short-circuit.", kind: "cable", size: (1, 1), layer: Back, tier: 2, body: "tin_block", category: Some("power"), stack: 200, params: {"amps": 32.0}),
    Building(id: "electric_furnace", name: "Electric furnace", description: "Smelts with electric heat up to 1600 °C.", kind: "furnace", size: (2, 2), tier: 2, body: "steel_block", max_temp: 1600, crafts: ["smelting"], power: Some((tier: 1, use_w: 9000.0, idle_w: 200.0))),
    Building(id: "macerator", name: "Macerator", description: "Grinds ore into crushed ore and dust.", kind: "crafter", size: (2, 2), tier: 2, body: "steel_block", max_temp: 500, crafts: ["crushing"], speed: 2.0, power: Some((tier: 1, use_w: 6000.0))),
    Building(id: "assembler", name: "Assembler", description: "Makes parts from parts.", kind: "crafter", size: (3, 2), tier: 2, body: "steel_block", max_temp: 500, crafts: ["assembling"], speed: 2.0, power: Some((tier: 1, use_w: 3500.0))),
    Building(id: "lv_lab", name: "LV lab", description: "Researches with kits up to the electric kit.", kind: "lab", size: (2, 2), tier: 2, body: "steel_block", category: Some("research"), power: Some((tier: 1, use_w: 4000.0))),
    Building(id: "electric_pump", name: "Electric pump", description: "Takes fluid from the world into a pipe.", kind: "pump", size: (1, 2), tier: 2, body: "steel_block", category: Some("logistics"), power: Some((tier: 1, use_w: 3000.0))),
    Building(id: "wire_mill", name: "Wire mill", description: "Draws rods into wires.", kind: "crafter", size: (2, 1), tier: 2, body: "steel_block", crafts: ["wire_drawing"], speed: 2.0, power: Some((tier: 1, use_w: 4000.0))),
